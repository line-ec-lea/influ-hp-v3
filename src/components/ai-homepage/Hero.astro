---
import CinematicSection from "@shared/CinematicSection.astro";
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import AsanohaHeroPattern from "@shared/AsanohaHeroPattern.astro";
import { CONTACT_FORM_HREF } from "@shared/features/contact";
const eyebrowClass =
  "text-xs font-bold tracking-widest text-[#1f4e79] uppercase"
---
<CinematicSection first>
<section class="relative overflow-hidden border-b border-[#1f4e79]/20 bg-[#f7f9fb] pt-14">
        <AsanohaHeroPattern class="opacity-20" />
        <Container class="relative py-20 sm:py-24 lg:py-32">
          <div class="max-w-4xl">
            <p class={eyebrowClass}>AI-READY HOMEPAGE</p>
            <SunlitHeading
              as="h1"
              delay={0.12}
              class="mt-5 text-balance text-4xl font-bold leading-tight tracking-tight text-[#1f4e79] md:text-6xl"
            >
              HPのAI化
            </SunlitHeading>
            <p class="mt-7 max-w-3xl text-xl font-bold leading-9 tracking-tight text-[#1f4e79] sm:text-2xl sm:leading-10">
              ホームページの運用を、外注任せから自社で改善できる状態へ。
            </p>
            <p class="mt-6 max-w-3xl text-base leading-8 text-[#30363d] sm:text-lg">
              更新・記事公開・サイト改善を、AI活用前提で自社主導に変える。
              単なる制作費の削減ではなく、マーケティングを速く正確に進めるための仕組みとして再設計します。
            </p>
            <div class="mt-7 inline-flex rounded-full border border-[#1f4e79]/25 bg-white px-4 py-2 text-sm font-bold text-[#1f4e79] shadow-sm">
              低価格で相談可能
            </div>
            <div class="mt-9">
              <SpecularButton
                href={CONTACT_FORM_HREF}
                target="_blank"
                rel="noopener noreferrer"
              >
                HPのAI化について相談する
              </SpecularButton>
            </div>
          </div>
        </Container>
      </section>
</CinematicSection>
