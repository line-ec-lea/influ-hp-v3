---
import CinematicSection from "@shared/CinematicSection.astro";
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
import CinematicReveal from "@shared/CinematicReveal.astro";
import AiHomepageFreefallCard from "./FreefallCard.astro";
const commonIssues = [
  "保守管理の内容が見えにくい",
  "軽微な修正にも、依頼と確認のやり取りが必要になる",
  "記事公開やSEO施策に時間がかかり、改善を進めにくい",
  "CMSやサーバーの更新・セキュリティ対応が把握しにくい",
]

const issueCardLayouts = [
  "lg:col-span-5 lg:col-start-2",
  "lg:col-span-5 lg:col-start-7 lg:-mt-4",
  "lg:col-span-7 lg:col-start-1 lg:-mt-1",
  "lg:col-span-5 lg:col-start-6 lg:-mt-9",
]
---
<CinematicSection>
<section
        class="relative overflow-hidden bg-[#090909]"
        aria-labelledby="issues-title"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 opacity-30 [background-image:radial-gradient(circle,rgba(224,197,132,0.42)_1px,transparent_1.25px)] [background-size:18px_18px]"
        />
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -left-24 top-28 h-72 w-72 rounded-full bg-[#E0C584]/8 blur-3xl"
        />
        <Container class="py-20 md:py-28 lg:py-32">
          <div class="relative">
            <CinematicReveal direction="left" class="max-w-2xl">
              <p class="text-xs font-bold tracking-[0.18em] text-[#E0C584] uppercase">
                COMMON ISSUES
              </p>
              <SunlitHeading
                id="issues-title"
                delay={0.08}
                class="mt-4 text-4xl font-bold leading-[1.18] tracking-[-0.045em] text-[#F5F1E8] sm:text-5xl lg:text-6xl"
              >
                よくある課題
              </SunlitHeading>
              <p class="mt-7 max-w-xl text-sm leading-8 text-[#CFC8BC] sm:text-base">
                更新や改善が外部への依頼待ちになり、ホームページがマーケティングの速度を下げていないかを確認します。
              </p>
            </CinematicReveal>

            <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:mt-20 lg:grid-cols-11 lg:items-center lg:gap-x-7 lg:gap-y-11">
              {commonIssues.map((issue, index) => (
                <li
                  class={`group ${issueCardLayouts[index] ?? ""}`}
                >
                  <AiHomepageFreefallCard
                    delay={0.06 + index * 0.07}
                    class="relative overflow-hidden rounded-[1.75rem] border-[3px] border-[#D7B568] bg-[#F5F1E8] px-6 py-6 shadow-[0_18px_0_rgba(224,197,132,0.16),0_26px_38px_rgba(0,0,0,0.35)] transition-[translate] duration-500 motion-safe:group-hover:-translate-y-2 motion-reduce:transition-none sm:px-7 sm:py-7 lg:px-8 lg:py-8"
                  >
                    <div class="relative max-w-2xl text-lg font-bold leading-8 tracking-[-0.03em] text-[#171512] sm:text-xl sm:leading-9">
                      {issue}
                    </div>
                  </AiHomepageFreefallCard>
                </li>
              ))}
            </ol>
          </div>
        </Container>
      </section>
</CinematicSection>
