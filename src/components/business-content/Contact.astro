---
import CinematicSection from "@shared/CinematicSection.astro";
import Container from "@shared/Container.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import { CONTACT_FORM_HREF } from "@shared/features/contact";
---
<CinematicSection>
  <section class="bg-page text-foreground" aria-labelledby="cta-title">
    <Container class="py-14 md:py-20 lg:py-24">
      <div class="grid gap-8 sm:gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-end lg:gap-12 xl:gap-16">
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold-300">
            START A CONVERSATION
          </p>
          <h2 id="cta-title" class="mt-4 text-[clamp(1.375rem,6.8vw,2rem)] font-bold leading-[1.45] tracking-[-0.025em] text-foreground sm:text-4xl sm:leading-[1.35] lg:text-[clamp(2rem,3.2vw,2.75rem)]">
            <span class="block">まだ、言葉にできなくても。</span>
            <span class="mt-1 block">相談から始められます。</span>
          </h2>
          <p class="mt-5 max-w-[36rem] text-pretty text-base leading-[1.8] text-muted sm:mt-6 sm:text-lg">
            今のお悩みをお聞きし、何から始めるべきか一緒に整理します。サービスを決めてからご相談いただく必要はありません。
          </p>
        </div>

        <div class="w-full min-w-0 max-w-[24rem] lg:justify-self-end">
          <div class="grid grid-cols-3 gap-3 sm:gap-4" role="list" aria-label="ご相談の流れ">
            {["話す", "整理する", "次を決める"].map((step, index) => (
              <div class="min-w-0" role="listitem">
                <div class="flex items-center gap-2">
                  <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rotate-45 border border-gold-300" />
                  <span class="text-xs font-bold tracking-[0.08em] text-gold-300 tabular-nums">
                    0{index + 1}
                  </span>
                </div>
                <p class="mt-2 text-sm font-bold leading-[1.6] text-foreground sm:text-base">{step}</p>
              </div>
            ))}
          </div>

          <div class="mt-5 sm:mt-6">
            <SpecularButton href={CONTACT_FORM_HREF} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
              まずは相談してみる
            </SpecularButton>
            <p class="mt-3 text-pretty text-sm leading-[1.8] text-muted">
              気になることから、お聞かせください。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>
</CinematicSection>
