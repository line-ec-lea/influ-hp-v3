---
import CinematicSection from "@shared/CinematicSection.astro";
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import CinematicReveal from "@shared/CinematicReveal.astro";
import BusinessSystemFlow from "./BusinessSystemFlow.astro";
import { routes } from "@shared/features/routes";
const primaryServices = [
  {
    number: "01",
    eyebrow: "AI-READY HOMEPAGE",
    title: "HPのAI化",
    lead: "既存ホームページを、AI活用前提の運用へ。",
    description:
      "ホームページを、専門業者へ依頼し続けるものから、社内で育てられる事業基盤へ変えていきます。",
    details: [
      {
        label: "今の課題",
        text: "更新のたびに、外部への依頼が必要になる。",
      },
      {
        label: "INFLUの支援",
        text: "社内で更新・改善できる仕組みを整える。",
      },
      {
        label: "実現する状態",
        text: "必要なときに、安全に改善を続けられる。",
      },
    ],
    href: routes.aiHomepage,
    cta: "HPのAI化を詳しく見る",
  },
  {
    number: "02",
    eyebrow: "AX SUPPORT",
    title: "AX・業務効率化支援",
    lead: "AIを、企業の業務とマーケティングの実務へ。",
    description:
      "AIを導入して終わらせず、現場で使い続けられる業務の仕組みとして定着させます。",
    details: [
      {
        label: "今の課題",
        text: "AIを導入しても、現場で使われない。",
      },
      {
        label: "INFLUの支援",
        text: "実際の業務に合わせて、運用を設計する。",
      },
      {
        label: "実現する状態",
        text: "現場が自ら使い、改善できるようになる。",
      },
    ],
    href: routes.axSupport,
    cta: "AX・業務効率化支援を詳しく見る",
  },
]

const eyebrowClass =
  "text-xs font-bold tracking-[0.14em] text-[#E0C584] uppercase"

const bodyClass = "text-base leading-[1.8] text-[#CFC8BC] lg:leading-[1.9]"
---
<CinematicSection>
<section
        class="bg-[#15130F]"
        aria-labelledby="primary-services-title"
      >
        <Container class="py-14 md:py-20">
          <div class="grid gap-6 sm:gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-16">
            <CinematicReveal direction="left">
              <p class={eyebrowClass}>PRIMARY SERVICES</p>
              <SunlitHeading
                id="primary-services-title"
                class="mt-4 text-[2rem] font-bold leading-[1.25] tracking-[-0.02em] sm:text-4xl lg:mt-5 lg:text-[clamp(2.5rem,3.6vw,3rem)] lg:leading-[1.25] lg:tracking-[-0.02em]"
              >
                <span class="block">INFLUがつくる、</span>
                <span class="mt-1 block">2つの事業基盤。</span>
              </SunlitHeading>
            </CinematicReveal>
            <CinematicReveal delay={0.1}>
              <p class="max-w-2xl text-base font-medium leading-[1.8] text-[#F5F1E8] sm:text-lg lg:max-w-[34rem] lg:font-medium lg:leading-[1.8] lg:text-foreground!">
                ホームページの運用改善と、企業全体のAX。
                <br class="hidden sm:block" />
                入口は異なっても、目指すのは「自社で動かし、改善を続けられる状態」です。
              </p>
              <p class={`mt-4 max-w-2xl lg:max-w-[34rem] ${bodyClass}`}>
                サイト、コンテンツ、SEO、計測、業務フローを分断せず、企業ごとの課題に合わせて必要な仕組みを設計します。
              </p>
            </CinematicReveal>
          </div>

          <div class="lg:mx-auto lg:max-w-[64rem]">
            <BusinessSystemFlow />
          </div>

          <div class="mt-10 space-y-12 lg:mt-12 lg:space-y-14">
            {primaryServices.map((service, serviceIndex) => (
              <CinematicReveal
                delay={serviceIndex * 0.08}
              >
                <div
                  data-primary-service={service.number}
                  class:list={[
                    "grid gap-5 lg:grid-cols-[7.5rem_minmax(0,1fr)] lg:gap-12",
                    serviceIndex === 0 && "[&_[data-service-detail]]:bg-transparent!",
                  ]}
                >
                  <div class="flex items-center gap-4 lg:block">
                    <p class="text-[3.5rem] font-bold leading-none tracking-[-0.08em] text-[#E0C584]/22 lg:text-[5rem] lg:tracking-[-0.04em]">
                      <span class="text-subtle">{service.number}</span>
                    </p>
                    <p class={`${eyebrowClass} lg:mt-3 lg:text-[0.625rem] lg:leading-[1.6]`}>{service.eyebrow}</p>
                  </div>

                  <div>
                    <h3 class="text-[1.75rem] font-bold leading-[1.3] tracking-[-0.02em] text-[#F5F1E8] sm:text-3xl lg:text-4xl lg:leading-[1.3] lg:tracking-[-0.02em]">
                      {service.title}
                    </h3>
                    <p class:list={[
                      "mt-3 max-w-3xl text-lg font-medium leading-[1.7] text-[#F5F1E8] lg:mt-4 lg:text-xl lg:font-medium lg:leading-[1.7] lg:tracking-normal lg:text-foreground!",
                      serviceIndex === 0 && "max-sm:text-balance",
                    ]}>
                      {serviceIndex === 0 ? <span class="text-foreground">{service.lead}</span> : service.lead}
                    </p>
                    <p class:list={[
                      `mt-3 max-w-3xl lg:max-w-[42rem] ${bodyClass}`,
                      serviceIndex === 0 && "text-balance",
                    ]}>
                      {service.description}
                    </p>

                    <dl class="mt-6 grid gap-5 md:grid-cols-3 md:gap-6 lg:mt-8">
                      {service.details.map((detail) => (
                        <div
                          data-service-detail={serviceIndex === 0 ? "" : undefined}
                          class:list={[
                            "relative bg-transparent!",
                            serviceIndex === 0 && "border-t border-line pt-4 md:pt-5",
                          ]}
                        >
                          <dt class="flex items-center gap-3 text-xs font-bold tracking-[0.08em] text-[#E0C584]">
                            <span class:list={["h-1.5 w-1.5 shrink-0 bg-gold-300", serviceIndex === 0 ? "rounded-[2px]" : "rounded-full"]} />
                            <span>{detail.label}</span>
                          </dt>
                          <dd class="mt-2 text-base font-medium leading-[1.8] text-[#F5F1E8] lg:mt-3">
                            <span>{detail.text}</span>
                          </dd>
                        </div>
                      ))}
                    </dl>

                    <div class:list={["flex justify-start", serviceIndex === 0 ? "mt-7 md:mt-8" : "mt-6"]}>
                      <SpecularButton href={service.href} mobileEffect class="max-sm:w-full max-sm:px-4">
                        {service.cta}
                      </SpecularButton>
                    </div>
                  </div>
                </div>
              </CinematicReveal>
            ))}
          </div>
        </Container>
      </section>
</CinematicSection>
