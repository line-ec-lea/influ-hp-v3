---
import CompanySectionLabel from "@shared/CompanySectionLabel.astro";
import CompanyProfileLink from "@shared/CompanyProfileLink.astro";
import { CONTACT_FORM_HREF } from "@shared/features/contact";
---
<section id="contact" aria-labelledby="contact-title" class="scroll-mt-24 overflow-hidden bg-section px-[var(--profile-gutter)] pb-[clamp(100px,16svh,200px)] pt-[clamp(120px,20svh,240px)]">
  <CompanySectionLabel>CONTACT</CompanySectionLabel>
  <p aria-hidden="true" class="mb-[clamp(40px,8svh,90px)] mt-[34px] text-[clamp(48px,14vw,280px)] font-bold leading-[0.9] tracking-[-0.04em]">LET’S TALK<span class="text-[#c89a5b]">.</span></p>
  <div class="grid items-end gap-[clamp(24px,4vw,64px)] min-[900px]:grid-cols-[7fr_5fr]">
    <div><h2 id="contact-title" class=" text-[2rem] font-bold leading-[1.3] tracking-[-0.02em] sm:text-4xl md:text-5xl lg:text-[3.5rem]">まずは、いまの課題を<br />聞かせてください。</h2><p class="mt-[18px] max-w-[30em] text-foreground/80">HPのAI化、AX・業務効率化、マーケティング支援について。何から始めるべきか決まっていない段階でも、ご相談いただけます。</p></div>
    <CompanyProfileLink href={CONTACT_FORM_HREF} external framed class="px-10! py-6! text-base!">相談してみる</CompanyProfileLink>
  </div>
</section>

<script>
  import { contactMotion } from "./profile-motion";
  contactMotion(document.querySelector<HTMLElement>("#contact"));
</script>
