---
import CompanySectionLabel from "@shared/CompanySectionLabel.astro";

const experienceStrengths = [
  {
    number: "01",
    context: "飲食店経営",
    title: ["事業を動かす、", "現場の感覚"],
    description:
      "初めての飲食店では、立ち上げから運営、閉店までを経験。現在も「焼肉処 味来」を運営しています。現場で向き合ってきた集客や日々の運営の課題を踏まえ、事業の状況に合う進め方を一緒に考えます。",
  },
  {
    number: "02",
    context: "WEB・LINEマーケティング",
    title: ["集客から販売までを、", "つなぐ"],
    description:
      "メールマガジンやLINE公式アカウントの運用、販売シナリオの設計を経験。誰に、何を、どの順番で伝えるかを考え、商品やサービスを必要とする人へ届ける仕組みづくりを支えます。",
  },
  {
    number: "03",
    context: "制作・運用・改善",
    title: ["つくった後も、", "改善を重ねる"],
    description:
      "ホームページやシステムの制作に加え、自社サービスでも施策を試し、数字や反応を確かめてきました。公開や導入の後も使い続けられるよう、日々の運用と改善まで見据えて仕組みを考えます。",
  },
];
---
<section id="experience" aria-labelledby="experience-title" class="relative scroll-mt-24 bg-section px-[var(--profile-gutter)] py-[clamp(96px,14svh,160px)]">
  <div class="mx-auto max-w-[1440px]">
    <div data-profile-experience-head class="grid gap-8 min-[900px]:grid-cols-[1.15fr_0.85fr] min-[900px]:items-end min-[900px]:gap-[clamp(48px,6vw,96px)]">
      <div>
        <CompanySectionLabel>EXPERIENCE</CompanySectionLabel>
        <h2 id="experience-title" class="mt-7 text-[clamp(30px,4.2vw,64px)] font-bold leading-[1.35] tracking-[-0.02em]">実務経験が、<br />支援の違いになる。</h2>
      </div>
      <p class="max-w-[30em] text-pretty text-base leading-[1.95] tracking-normal text-foreground/75 min-[1200px]:text-lg">飲食店の経営から、WEB・LINEを使った集客、システムの制作と運用まで。自ら事業を動かしてきた経験を、お客様の課題を考える視点として生かしています。</p>
    </div>

    <div class="mt-[clamp(56px,9svh,100px)]">
      {experienceStrengths.map(strength => (
        <article aria-labelledby={`experience-${strength.number}`} class="relative grid gap-x-[clamp(24px,4vw,64px)] gap-y-6 py-[clamp(36px,6svh,64px)] min-[900px]:grid-cols-[5.5rem_1fr_1fr] min-[900px]:items-start min-[1200px]:grid-cols-[7rem_1fr_1fr]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-[#c89a5b]/65 via-foreground/20 to-foreground/10"></div>
          <p aria-hidden="true" class="text-[clamp(48px,5.5vw,80px)] font-bold leading-none tracking-[-0.04em] text-[#c89a5b]/80">{strength.number}</p>
          <div>
            <p class="mb-4 text-xs font-bold leading-[1.6] tracking-[0.04em] text-[#c89a5b] sm:text-sm">{strength.context}</p>
            <h3 id={`experience-${strength.number}`} class="text-[clamp(24px,2.4vw,36px)] font-bold leading-[1.55] tracking-[-0.01em]">{strength.title.map(line => <span class="block">{line}</span>)}</h3>
          </div>
          <p class="max-w-[32em] text-pretty text-base leading-[1.95] tracking-normal text-foreground/80 min-[900px]:pt-1 min-[1200px]:text-lg">{strength.description}</p>
        </article>
      ))}
      <div aria-hidden="true" class="h-px bg-foreground/15"></div>
    </div>
  </div>
</section>

<script>
  import { experienceMotion } from "./profile-motion";
  experienceMotion(document.querySelector<HTMLElement>("#experience"));
</script>
