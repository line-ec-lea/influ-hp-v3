---
const film = "/media/company-profile/influ-boss-introduction.mp4";
---
<div data-profile-full-film>
  <a href={film} target="_blank" rel="noopener noreferrer" data-profile-film-open class="inline-flex items-center gap-3 border border-[#c89a5b]/55 px-4 py-2 text-sm font-semibold text-foreground hover:border-[#c89a5b]">紹介映像を見る <span class="text-[#c89a5b]">01:21</span></a>
  <dialog aria-label="代表取締役 水戸亮太 紹介映像" class="m-auto w-[min(1200px,92vw)] max-w-none overflow-visible border-0 bg-transparent p-0 pt-12 text-[#f4f7f2] backdrop:bg-[#060606]/92">
    <button type="button" data-profile-film-close autofocus class="absolute right-0 top-1 px-2 py-2.5 text-xs tracking-[0.2em] hover:text-[#c89a5b]">閉じる ✕</button>
    <video data-src={film} controls playsinline preload="none" poster="/media/company-profile/poster.jpg" class="aspect-[1600/706] w-full bg-page"></video>
  </dialog>
</div>
<script>
  const root = document.querySelector<HTMLElement>("[data-profile-full-film]")!;
  const opener = root.querySelector<HTMLAnchorElement>("[data-profile-film-open]")!;
  const dialog = root.querySelector<HTMLDialogElement>("dialog")!;
  const film = dialog.querySelector<HTMLVideoElement>("video")!;
  const page = root.closest<HTMLElement>("[data-company-profile]")!;
  if (typeof dialog.showModal === "function") {
    opener.setAttribute("aria-haspopup", "dialog");
    const notify = () => page.dispatchEvent(new CustomEvent("profile:film-dialog", { detail: dialog.open }));
    opener.addEventListener("click", event => {
      if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (!film.getAttribute("src")) { film.src = film.dataset.src!; film.load(); }
      dialog.showModal();
      notify();
      film.play().catch(() => { /* Native controls remain available if playback needs another gesture. */ });
    });
    root.querySelector("[data-profile-film-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", event => {
      const rect = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
    });
    dialog.addEventListener("close", () => { film.pause(); notify(); opener.focus({ preventScroll: true }); });
    document.addEventListener("visibilitychange", () => { if (document.hidden) film.pause(); });
    window.addEventListener("pagehide", () => { film.pause(); if (dialog.open) dialog.close(); });
  }
</script>
