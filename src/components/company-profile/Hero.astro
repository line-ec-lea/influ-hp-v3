---
import BackgroundFilm from "./BackgroundFilm.astro";
import CompanySectionLabel from "@shared/CompanySectionLabel.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import { CONTACT_FORM_HREF } from "@shared/features/contact";
---
<section id="company" aria-labelledby="company-title" data-profile-hero class="relative isolate grid min-h-svh grid-rows-[auto_1fr_auto] overflow-hidden bg-section px-[var(--profile-gutter)] pb-16 pt-[clamp(120px,18svh,200px)]">
  <BackgroundFilm name="hero" poster="/media/company-profile/bg-hero.jpg" src="/media/company-profile/bg-hero.mp4" class="object-[60%_50%] min-[900px]:object-center" />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(6,6,6,0.35),transparent_30%,transparent_70%,var(--color-section)),linear-gradient(90deg,rgba(6,6,6,0.9),rgba(6,6,6,0.72)_45%,rgba(6,6,6,0.38))]"></div>
  <div data-profile-hero-top class="flex flex-wrap items-center gap-6">
    <CompanySectionLabel>COMPANY</CompanySectionLabel>
    <p class="text-xs font-bold tracking-[0.16em] text-foreground/80">会社概要</p>
  </div>
  <div class="self-center py-[6svh]">
    <h1 id="company-title" class="text-[clamp(2rem,8.8vw,3rem)] font-extrabold leading-[1.18] tracking-[-0.02em] text-foreground lg:text-[clamp(3.5rem,4.5vw,5.5rem)]" data-profile-headline>
      <span class="block overflow-hidden"><span class="inline-block" data-profile-hero-line data-profile-delay="0.0"><span class="inline-block">技術と</span><span class="inline-block">マーケティングを、</span></span></span>
      <span class="block overflow-hidden"><span class="inline-block" data-profile-hero-line data-profile-delay="0.12"><span class="inline-block">現場で</span><span class="inline-block">使い続けられる</span></span></span>
      <span class="block overflow-hidden"><span class="inline-block" data-profile-hero-line data-profile-delay="0.24">仕組みへ。</span></span>
    </h1>
    <span data-profile-rule class="my-[clamp(28px,5svh,56px)] block h-px w-[clamp(80px,18vw,300px)] bg-[#c89a5b]" aria-hidden="true"></span>
    <p data-profile-lead class="max-w-[34rem] text-pretty text-base leading-[1.9] text-foreground/90">INFLUは、AI活用・AXとマーケティングをつなぎ、企業が自ら運用・改善できる状態を目指して伴走する支援会社です。</p>
    <SpecularButton href={CONTACT_FORM_HREF} target="_blank" rel="noopener noreferrer" mobileEffect class="mt-9 !text-foreground max-sm:min-h-12 max-sm:!rounded-lg max-sm:!px-4 max-sm:!text-sm max-sm:!shadow-none">INFLUに相談する</SpecularButton>
  </div>
  <div data-profile-hero-foot class="flex flex-wrap items-end justify-between gap-5 text-[0.625rem] font-bold tracking-[0.2em] text-foreground/70">
    <a href="#direction" class="inline-flex items-center gap-3.5"><span class="block h-12 w-px bg-[linear-gradient(#c89a5b,transparent)]" aria-hidden="true"></span>SCROLL<span class="sr-only">：現在の支援領域へ</span></a>
  </div>
</section>

<script>
  import { heroMotion } from "./profile-motion";
  heroMotion(document.querySelector<HTMLElement>("[data-profile-hero]"));
</script>
