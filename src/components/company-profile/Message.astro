---
import CompanySectionLabel from "@shared/CompanySectionLabel.astro";
import BackgroundFilm from "./BackgroundFilm.astro";
import FilmDialog from "./FilmDialog.astro";
---
<section id="a01" aria-labelledby="message-title" class="scroll-mt-24 bg-section" data-profile-message>
  <div data-profile-message-pin class="group/profile-message relative data-[motion-desktop]:h-[var(--profile-scroll-height)]">
  <div id="message" class="relative isolate flex min-h-svh group-data-[motion-desktop]/profile-message:sticky group-data-[motion-desktop]/profile-message:top-0 group-data-[motion-desktop]/profile-message:h-[var(--profile-viewport)] scroll-mt-24 flex-col justify-between gap-12 overflow-hidden px-[var(--profile-gutter)] pb-12 pt-[clamp(110px,14svh,150px)] min-[900px]:pb-[10svh] min-[900px]:pt-[15svh]" data-profile-message-stage>
    <BackgroundFilm name="message" poster="/media/company-profile/bg-message.jpg" src="/media/company-profile/bg-message.mp4" class="object-[65%_50%]" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,var(--color-section),transparent_22%,transparent_72%,var(--color-section)),linear-gradient(90deg,rgba(6,6,6,0.82),rgba(6,6,6,0.45)_55%,rgba(6,6,6,0.2))]"></div>
    <div data-profile-message-cover aria-hidden="true" class="pointer-events-none absolute inset-0 z-10 hidden bg-section group-data-[motion-active]/profile-message:block"></div>
    <div data-profile-message-head class="relative z-20 min-[900px]:max-w-[52vw]">
      <CompanySectionLabel>MESSAGE</CompanySectionLabel>
      <h2 id="message-title" class="mt-6 text-[2rem] font-bold leading-[1.3] tracking-[-0.02em] sm:text-4xl md:text-5xl lg:text-[3.5rem]">挑戦を、<br />続けられる仕組みに。</h2>
    </div>
    <div data-profile-message-foot class="relative z-20 flex flex-wrap items-end justify-between gap-6">
      <div class="grid gap-1.5">
        <p class="text-xs font-bold tracking-[0.16em] text-foreground/70">INFLU / REPRESENTATIVE DIRECTOR</p>
        <p class="text-xl font-bold leading-[1.5] tracking-[-0.01em] sm:text-2xl lg:text-[1.75rem]">HEY, I'M GOCHAN</p>
        <p class="text-sm tracking-normal text-foreground/80">代表取締役 水戸 亮太</p>
      </div>
      <FilmDialog />
    </div>
  </div>
  </div>
  <div data-profile-message-body class="grid grid-cols-1 gap-x-[clamp(16px,2vw,32px)] px-[var(--profile-gutter)] pb-[clamp(80px,16svh,200px)] pt-[clamp(60px,14svh,180px)] min-[900px]:grid-cols-12">
    <p class="text-xl font-normal leading-[1.7] sm:text-2xl min-[900px]:col-span-10">これまで、お客様の商品やサービスを必要な人へ届けるために、何をすべきかを常に考えてきました。お客様の事業が成長することが、私たちの喜びでもあります。</p>
    <p class="mt-14 text-base leading-[1.9] text-foreground/80 max-[899px]:ml-[12%] min-[900px]:col-span-5 min-[900px]:col-start-7 min-[900px]:mt-[clamp(56px,14svh,160px)]">飲食店の経営、WEBでの情報発信、メールや公式LINEを使った販売支援、システムづくり。異なるように見える経験のすべてに共通していたのは、現場で試し、数字や反応を確認し、次の改善へつなげることでした。</p>
    <figure class="mt-14 aspect-[4/5] overflow-hidden bg-surface max-[899px]:w-[78%] min-[900px]:col-span-5 min-[900px]:mt-[clamp(56px,12svh,140px)]">
      <img src="/images/company-profile/gochan-message.jpeg" alt="株式会社INFLU 代表取締役 水戸亮太" loading="lazy" decoding="async" class="h-full w-full object-cover" />
    </figure>
    <p class="mt-14 self-end text-base leading-[1.9] text-foreground/80 max-[899px]:ml-[12%] min-[900px]:col-span-5 min-[900px]:col-start-7 min-[900px]:mt-[clamp(56px,12svh,140px)]">個人時代から一貫して、個人や小さな組織が挑戦し、成長できるよう全面的に支えることを目指してきました。これまで掲げてきた「ノーコードで起業する」という考えを、現在はAIを使いながら自社で運用・改善できる仕組みづくりへ発展させています。</p>
    <p class="mt-14 text-base leading-[1.9] text-foreground/80 min-[900px]:col-span-6 min-[900px]:col-start-3 min-[900px]:mt-[clamp(56px,14svh,160px)]">目先の施策だけではなく、事業の背景や成長の段階を理解し、長期的な視点で一緒に考える組織でありたいと思っています。事業の成長が、その先の社会価値につながるよう支援を続けてまいります。</p>
    <figure class="mt-14 grid justify-items-start gap-3.5 min-[900px]:col-span-5 min-[900px]:col-start-8 min-[900px]:mt-[clamp(56px,12svh,140px)]">
      <img src="/influhp-assets/wp-content/themes/top/images/name.png" alt="水戸 亮太の署名" width="208" height="30" loading="lazy" decoding="async" class="h-auto w-52 max-w-full brightness-0 invert" />
      <figcaption class="text-sm tracking-normal text-foreground/80"><span class="block text-xs font-bold tracking-[0.16em] text-foreground/70">REPRESENTATIVE DIRECTOR</span>代表取締役 水戸 亮太</figcaption>
    </figure>
  </div>
</section>

<script>
  import { messageMotion } from "./profile-motion";
  messageMotion(document.querySelector<HTMLElement>("[data-profile-message]"));
</script>
