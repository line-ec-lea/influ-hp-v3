---
import CompanySectionLabel from "@shared/CompanySectionLabel.astro";
const companyPhilosophy = {
  mission: {
    label: "ミッション",
    headline:
      "「誰もがクリエイティブなアイディアや商品やサービスをカンタンに届ける世界を創る」",
    body: "誰でも、自分の新しいアイディアや商品、サービスをカンタンに届けることができる世界を目指します。",
  },
  vision: {
    label: "ビジョン",
    headline: "モノ、ジバ、ヒトが集まり成長するコミュニティ",
    tagline: "とにかく試そう、とにかく語ろう！",
  },
  coreValues: {
    label: "コアバリュー",
    items: [
      "とにかく、試す。納得いくまで",
      "とにかく、語ってみる。自分が腹落ちするまで",
      "とにかく、出来るように。自然と当たり前に。",
      "できないことをできるようになろう！",
      "過去の成功や常識にとらわれず、いつも新しいアイディアや視点を",
      "成長と上達のために学び、教える。",
    ],
  },
} as const
---
<section id="philosophy" aria-labelledby="philosophy-title" class="scroll-mt-24 bg-section">
  <div data-profile-philosophy-pin class="group/profile-philosophy relative data-[motion-desktop]:h-[var(--profile-scroll-height)]">
  <div class="relative group-data-[motion-desktop]/profile-philosophy:sticky group-data-[motion-desktop]/profile-philosophy:top-0 group-data-[motion-desktop]/profile-philosophy:h-[var(--profile-viewport)] group-data-[motion-desktop]/profile-philosophy:overflow-clip group-data-[motion-desktop]/profile-philosophy:p-0! px-[var(--profile-gutter)] pb-10 pt-[clamp(110px,16svh,180px)]" data-profile-philosophy-stage>
    <CompanySectionLabel class="group-data-[motion-desktop]/profile-philosophy:absolute group-data-[motion-desktop]/profile-philosophy:left-[var(--profile-gutter)] group-data-[motion-desktop]/profile-philosophy:top-[14vh]">PHILOSOPHY</CompanySectionLabel>
    <h2 id="philosophy-title" class="group-data-[motion-desktop]/profile-philosophy:absolute group-data-[motion-desktop]/profile-philosophy:inset-0 group-data-[motion-desktop]/profile-philosophy:m-0! group-data-[motion-desktop]/profile-philosophy:block! group-data-[motion-desktop]/profile-philosophy:text-[clamp(5rem,9.5vw,8.5rem)]! my-[30px] grid gap-[0.1em] text-[clamp(3rem,11vw,5rem)] font-bold leading-[1.08] tracking-[-0.02em]">
      <span class="block group-data-[motion-desktop]/profile-philosophy:absolute group-data-[motion-desktop]/profile-philosophy:left-[var(--profile-gutter)] group-data-[motion-desktop]/profile-philosophy:top-[22vh]">つくる。</span><span class="block pl-[14%] group-data-[motion-desktop]/profile-philosophy:absolute group-data-[motion-desktop]/profile-philosophy:left-[28vw] group-data-[motion-desktop]/profile-philosophy:top-[43vh] group-data-[motion-desktop]/profile-philosophy:pl-0!">届ける。</span><span class="block pl-[28%] group-data-[motion-desktop]/profile-philosophy:absolute group-data-[motion-desktop]/profile-philosophy:left-[51vw] group-data-[motion-desktop]/profile-philosophy:top-[64vh] group-data-[motion-desktop]/profile-philosophy:pl-0!">育てる。</span>
    </h2>
    <p data-profile-philosophy-description class="group-data-[motion-desktop]/profile-philosophy:absolute group-data-[motion-desktop]/profile-philosophy:left-[var(--profile-gutter)] group-data-[motion-desktop]/profile-philosophy:bottom-[12vh] group-data-[motion-desktop]/profile-philosophy:max-w-[24em] max-w-[30em] text-foreground/80">INFLUは、挑戦する人のアイデアを形にし、必要な人へ届け、その先で続いていく力を育てます。</p>
  </div>
  </div>
  <div class="grid gap-12 px-[var(--profile-gutter)] pb-[clamp(100px,16svh,200px)] pt-[clamp(60px,12svh,140px)] min-[900px]:grid-cols-3 min-[900px]:gap-[clamp(24px,4vw,64px)]">
    <article class="border-t border-[#f4f7f2]/12 pt-[26px]">
      <div class="flex items-baseline justify-between gap-4"><p class="text-xl font-bold">つくる</p><p class="text-xs font-bold tracking-[0.16em] text-[#c89a5b]">MISSION</p></div>
      <h3 class="mb-3.5 mt-6 text-xl font-bold leading-[1.5] tracking-[-0.01em] sm:text-2xl lg:text-[1.75rem]">{companyPhilosophy.mission.headline}</h3>
      <p class="text-base text-foreground/80">{companyPhilosophy.mission.body}</p>
    </article>
    <article class="border-t border-[#f4f7f2]/12 pt-[26px]">
      <div class="flex items-baseline justify-between gap-4"><p class="text-xl font-bold">届ける</p><p class="text-xs font-bold tracking-[0.16em] text-[#c89a5b]">VISION</p></div>
      <h3 class="mb-3.5 mt-6 text-xl font-bold leading-[1.5] tracking-[-0.01em] sm:text-2xl lg:text-[1.75rem]">モノ、ジバ、ヒトを、つなげる。</h3>
      <p class="text-base text-foreground/80">{companyPhilosophy.vision.headline}</p>
    </article>
    <article class="border-t border-[#f4f7f2]/12 pt-[26px]">
      <div class="flex items-baseline justify-between gap-4"><p class="text-xl font-bold">育てる</p><p class="text-xs font-bold tracking-[0.16em] text-[#c89a5b]">CORE VALUE</p></div>
      <h3 class="mb-3.5 mt-6 text-xl font-bold leading-[1.5] tracking-[-0.01em] sm:text-2xl lg:text-[1.75rem]">試し、語り、学び続ける。</h3>
      <ul class="text-base text-foreground/80">{companyPhilosophy.coreValues.items.map((value) => <li class="border-b border-[#f4f7f2]/12 py-2">{value}</li>)}</ul>
      <p class="mt-[18px] text-base">{companyPhilosophy.vision.tagline}</p>
    </article>
  </div>
</section>

<script>
  import { philosophyMotion } from "./profile-motion";
  philosophyMotion(document.querySelector<HTMLElement>("#philosophy"));
</script>
