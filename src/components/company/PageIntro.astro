---
interface Props { label: string; title: string; lead: string; description?: string }
const { label, title, lead, description } = Astro.props;
---
<header class="border-b border-rule px-5 pt-10 pb-16 sm:px-8 md:pt-14 md:pb-24 xl:px-12 2xl:px-16">
  <div class="flex items-center justify-between gap-6 text-xs tracking-widest"><span>{label}</span><a class="py-3 hover:text-accent" href="/">HOME <span aria-hidden="true">↗</span></a></div>
  <h1 class="my-16 text-[clamp(2.5rem,6vw,7rem)] font-semibold leading-tight tracking-tight md:my-24">{title}</h1>
  <div class="grid gap-8 lg:grid-cols-2 lg:gap-24"><h2 class="max-w-2xl text-2xl font-medium leading-relaxed md:text-3xl">{lead}</h2>{description && <p class="max-w-2xl leading-loose text-secondary">{description}</p>}</div>
</header>
