<div
  class="display-switch flex rounded-full border border-rule p-1 [&_button]:grid [&_button]:size-11 [&_button]:cursor-pointer [&_button]:place-content-center [&_button]:rounded-full [&_button]:text-secondary [&_button[aria-pressed=true]]:bg-ink [&_button[aria-pressed=true]]:text-canvas [&_svg]:size-4 [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:stroke-[1.5]"
  role="group"
  aria-label="表示テーマ"
>
  <button
    type="button"
    data-theme="light"
    aria-label="ライトモード"
    title="ライトモード"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
  </button>
  <button
    type="button"
    data-theme="dark"
    aria-label="ダークモード"
    title="ダークモード"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" />
    </svg>
  </button>
  <button
    type="button"
    data-theme="system"
    aria-label="システム設定に合わせる"
    title="システム設定"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4" width="18" height="13" rx="1" />
      <path d="M8 21h8m-4-4v4" />
    </svg>
  </button>
</div>
<script>
  // Shares the original EmDash template's theme cookie and OS fallback.
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    ".display-switch [data-theme]",
  );
  function applyTheme(theme: string, persist = false) {
    const value = theme === "light" || theme === "dark" ? theme : "system";
    const root = document.documentElement;
    root.classList.remove("light", "dark");
    if (value !== "system") root.classList.add(value);
    if (persist) {
      const secure = location.protocol === "https:" ? "; Secure" : "";
      document.cookie = `theme=${value === "system" ? "" : value}; path=/; max-age=${value === "system" ? 0 : 31536000}; SameSite=Lax${secure}`;
    }
    buttons.forEach((button) =>
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.theme === value),
      ),
    );
  }
  applyTheme(
    document.cookie
      .split("; ")
      .find((row) => row.startsWith("theme="))
      ?.slice(6) ?? "system",
  );
  buttons.forEach((button) =>
    button.addEventListener("click", () =>
      applyTheme(button.dataset.theme ?? "system", true),
    ),
  );
</script>
