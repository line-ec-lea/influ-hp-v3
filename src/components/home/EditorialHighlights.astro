---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import { editorialImageDimensions } from "@shared/editorial-image";

interface Props {
  id: "achievements" | "columns";
  title: string;
  eyebrow: string;
  description: string;
  basePath: string;
  archiveLabel: string;
  error?: boolean;
  entries: {
    id: string;
    data: {
      title: string;
      featured_image?: MediaValue;
      excerpt?: string;
      publishedAt: Date | null;
    };
  }[];
}
const { id, title, eyebrow, description, basePath, archiveLabel, entries, error = false } = Astro.props;
const formatDate = (date: Date) => date.toLocaleDateString("ja-JP", {
  timeZone: "Asia/Tokyo", year: "numeric", month: "long", day: "numeric",
});
---

<section id={id} aria-labelledby={`${id}-heading`} class="relative overflow-hidden bg-[#0B0B0B]" data-editorial-highlights>
  <Container class="py-18 md:py-24 lg:py-28">
    <div class="max-w-5xl" data-stories-intro>
      <p class="text-xs font-bold tracking-[0.16em] text-gold-300">{eyebrow}</p>
      <SunlitHeading id={`${id}-heading`} class="mt-4 text-[2rem] font-bold leading-[1.3] tracking-[-0.02em] sm:text-4xl md:text-5xl lg:text-[3.5rem]">
        {title}
      </SunlitHeading>
      <p class="mt-6 max-w-[40rem] text-pretty text-base leading-[1.9] text-foreground/80">{description}</p>
    </div>

    {error ? (
      <p class="mt-10 text-base leading-[1.9] text-muted md:mt-14" data-stories-empty>
        現在、記事を読み込めません。時間をおいて再度お試しください。
      </p>
    ) : entries.length === 0 ? (
      <p class="mt-10 text-base leading-[1.9] text-muted md:mt-14" data-stories-empty>
        公開された記事がここに表示されます。
      </p>
    ) : (
      <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 md:mt-14" class:list={[id === "achievements" ? "lg:grid-cols-3" : "lg:grid-cols-4"]}>
        {entries.map(entry => (
          <article class="min-w-0" data-story>
            <a href={`${basePath}/${entry.id}`} class="group flex h-full flex-col rounded-sm">
              <div class="aspect-[3/2] overflow-hidden rounded-md bg-elevated [&_picture]:h-full [&_img]:!h-full [&_img]:!w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-500 motion-safe:group-hover:[&_img]:scale-[1.03]">
                {entry.data.featured_image ? (
                  <Image image={entry.data.featured_image} {...editorialImageDimensions(entry.data.featured_image)} sizes={id === "achievements" ? "(min-width: 1024px) 380px, (min-width: 640px) 50vw, calc(100vw - 40px)" : "(min-width: 1024px) 280px, (min-width: 640px) 50vw, calc(100vw - 40px)"} />
                ) : (
                  <span class="flex h-full items-center justify-center text-xs tracking-[0.16em] text-subtle">画像なし</span>
                )}
              </div>
              {entry.data.publishedAt && (
                <time datetime={entry.data.publishedAt.toISOString()} class="mt-5 text-xs leading-[1.7] text-muted">{formatDate(entry.data.publishedAt)}</time>
              )}
              <h3 class="mt-3 text-xl font-bold leading-[1.5] tracking-[-0.01em] text-foreground transition-colors group-hover:text-gold-300">{entry.data.title}</h3>
              {entry.data.excerpt && <p class="mt-3 line-clamp-3 text-base leading-[1.9] text-foreground/80">{entry.data.excerpt}</p>}
            </a>
          </article>
        ))}
      </div>
    )}

    <div class="mt-8 md:mt-10" data-stories-cta>
      <SpecularButton href={`${basePath}/page/1`}>{archiveLabel}</SpecularButton>
    </div>
  </Container>
</section>
