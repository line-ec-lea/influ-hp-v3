<div aria-hidden="true" class="fixed inset-0 z-[300] grid place-items-center overflow-hidden bg-[#07090A] pointer-events-auto motion-reduce:hidden" data-logo-intro hidden>
      <div class="relative flex origin-center flex-col items-center opacity-0" data-intro-content>
        <div class="relative h-[186px] w-[279px] sm:h-[226.7px] sm:w-[340px]">
          <div class="h-[226.7px] w-[340px] absolute left-1/2 top-1/2 origin-center -translate-x-1/2 -translate-y-1/2 scale-[0.82] sm:scale-100">
            <div class="bg-[radial-gradient(circle,rgba(200,154,91,0.18)_0%,rgba(200,154,91,0.1)_32%,transparent_60%)] pointer-events-none absolute left-1/2 top-1/2 h-[300px] w-[420px] -translate-x-1/2 -translate-y-1/2" data-glow />

            <div class="absolute inset-0" data-logo-reveal>
              <img src="/influ-logo.svg" alt="" sizes="340px" class="absolute inset-0 h-full w-full object-contain" />
            </div>

            <div class="bg-[linear-gradient(90deg,transparent,#C89A5B,transparent)] absolute left-1/2 top-[130px] h-px w-[420px] -translate-x-1/2 origin-center" data-intro-line />
          </div>
        </div>

        <p class="mt-3 text-center text-[12px] font-semibold uppercase tracking-[0.34em] text-[#F4F7F2]" data-caption>
          株式会社INFLU
        </p>
      </div>
    </div>
<script is:inline>
  // Run during HTML parsing so the overlay covers the page before bundled JS loads.
  (() => {
    const intro = document.currentScript.previousElementSibling;
    const navigation = performance.getEntriesByType("navigation")[0];
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        (location.hash && location.hash !== "#hero") || window.scrollY > 0 ||
        navigation?.type === "back_forward") return;

    intro.hidden = false;
    intro.dataset.introPending = "true";
    // Keep the homepage reachable if the animation bundle fails to load.
    window.setTimeout(() => {
      if (intro.dataset.introPending === "true") {
        intro.hidden = true;
        delete intro.dataset.introPending;
      }
    }, 8000);
  })();
</script>
