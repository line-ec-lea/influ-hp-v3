---
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import { routes } from "@shared/features/routes";
const serviceLinks = [
  {
    href: routes.aiHomepage,
    cta: "HPのAI化を見る",
  },
  {
    href: routes.axSupport,
    cta: "AX支援を見る",
  },
]

const serviceSequence = [
  "既存サイトの作り直し",
  "更新・記事公開の内製化",
  "問い合わせ導線の改善",
  "AIを活用した運用設計",
  "AIマーケティング支援",
  "業務フロー改善",
  "AIツール導入・活用支援",
]
---
<section id="services" class="relative overflow-hidden border-t border-[rgba(200,164,93,0.25)] bg-[#15130F]">
      <Container class="relative py-16 md:py-24 lg:py-28">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.48fr)] lg:items-end" data-intro>
          <div>
            <p class="text-xs font-bold tracking-[0.16em] text-[#E0C584]">
              OUR SERVICES
            </p>
            <SunlitHeading class="mt-4 text-4xl font-bold leading-tight tracking-[-0.03em] md:text-5xl lg:text-6xl">
              事業内容
            </SunlitHeading>
          </div>
        </div>

        <div class="mt-12 border-y border-[rgba(216,194,139,0.24)] py-8 sm:py-10 md:mt-14 lg:py-12" aria-label={`提供領域: ${serviceSequence.join("、")}`} data-sequence data-items={JSON.stringify(serviceSequence)}>
          <div aria-hidden="true" class="grid items-center gap-4 lg:grid-cols-[minmax(14rem,0.46fr)_minmax(0,1fr)] lg:gap-10">
            <div class="flex items-center gap-4">
              <p class="whitespace-nowrap text-[clamp(2.8rem,7vw,6.75rem)] font-bold leading-none tracking-[-0.075em] text-[#F5F1E8]">
                WE DO
              </p>
              <span class="h-[clamp(2.6rem,6vw,5.6rem)] w-px shrink-0 bg-[linear-gradient(180deg,transparent,#F4E8CB_18%,#FFFDF7_50%,#D8C28B_82%,transparent)]" data-divider />
            </div>

            <div class="relative flex min-h-[4.25rem] items-center overflow-hidden sm:min-h-[5.2rem] lg:min-h-[6.5rem]">
              <p class="whitespace-nowrap bg-[linear-gradient(105deg,#FFFDF7_0%,#F4E8CB_55%,#D8C28B_100%)] bg-clip-text text-[clamp(1.15rem,4.2vw,3rem)] font-bold leading-none tracking-[-0.045em] text-transparent" data-service>
                  {serviceSequence[0]}
                </p>
            </div>
          </div>

          <div aria-hidden="true" class="mt-6 flex items-center gap-2 lg:ml-[calc(31.5%+2.5rem)]">
            {serviceSequence.map((_, index) => (
              <span class="h-px bg-[#D8C28B]" data-indicator class:list={[index === 0 ? "w-[34px] opacity-100" : "w-3 opacity-[0.24]"]} />
            ))}
          </div>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap" data-links>
            {serviceLinks.map((service) => (
              <SpecularButton href={service.href}>
                {service.cta}
              </SpecularButton>
            ))}
          </div>

          <p class="mt-8 border-l border-[rgba(200,164,93,0.45)] pl-4 text-sm leading-7 text-[#CFC8BC]">
            LINEや既存のマーケティング支援は、企業ごとの課題に応じて補足的にご案内します。
          </p>
        </div>
      </Container>
    </section>
<script>
  import { animate, inView, ease, reducedMotion, reveal } from "@shared/motion";
  const section = document.querySelector("#services")!;
  reveal(section.querySelector("[data-intro]")!, { opacity: [0, 1], y: [20, 0] }, { duration: 0.5 });
  const sequence = section.querySelector<HTMLElement>("[data-sequence]")!;
  reveal(sequence, { opacity: [0, 1], y: [18, 0] }, { duration: 0.55 });
  reveal(section.querySelector("[data-links]")!, { opacity: [0, 1], y: [14, 0] }, { duration: 0.5 });
  const items: string[] = JSON.parse(sequence.dataset.items!);
  const text = section.querySelector<HTMLElement>("[data-service]")!;
  const indicators = [...section.querySelectorAll<HTMLElement>("[data-indicator]")];
  let current = 0;
  let visible = false;
  inView(sequence, () => { visible = true; return () => { visible = false; }; }, { margin: "0px 0px 42% 0px" });
  if (!reducedMotion.matches) animate(section.querySelector("[data-divider]")!, {
    opacity: [0.38, 1, 0.38],
    boxShadow: ["0 0 3px rgba(244,232,203,0.16)", "0 0 16px rgba(255,253,247,0.7)", "0 0 3px rgba(244,232,203,0.16)"]
  }, { duration: 1.15, repeat: Infinity, ease: "easeInOut" });
  const timer = window.setInterval(async () => {
    if (!visible || reducedMotion.matches || document.hidden) return;
    current = (current + 1) % items.length;
    indicators.forEach((indicator, index) => animate(indicator,
      { opacity: index === current ? 1 : 0.24, width: index === current ? 34 : 12 }, { duration: 0.32, ease }));
    await animate(text, { opacity: 0, y: "-95%", filter: "blur(9px)" }, { duration: 0.48, ease });
    text.textContent = items[current];
    animate(text, { opacity: [0, 1], y: ["95%", "0%"], filter: ["blur(9px)", "blur(0px)"] }, { duration: 0.48, ease });
  }, 1850);
  window.addEventListener("pagehide", (event) => { if (!event.persisted) clearInterval(timer); });
</script>
