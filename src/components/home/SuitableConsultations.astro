---
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
import SpecularButton from "@shared/SpecularButton.astro";
import { CONTACT_FORM_HREF } from "@shared/features/contact";
const consultations = [
  "企業のAI活用をどこから始めるか整理したい",
  "既存HPが更新できず、運用の足かせになっている",
]
---
<section id="suitable-consultations" class="relative overflow-hidden border-t border-[rgba(200,164,93,0.25)] bg-[#0B0B0B]">
      <Container class="relative py-16 md:py-24 lg:py-28">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(24rem,0.72fr)] lg:items-end" data-intro>
          <div>
            <p class="text-xs font-bold tracking-[0.16em] text-[#E0C584]">
              SUITABLE CONSULTATIONS
            </p>
            <SunlitHeading class="mt-4 text-4xl font-bold leading-tight tracking-[-0.03em] md:text-5xl lg:text-6xl">
              <span class="block">こんなお悩みから、</span>
              <span class="block">ご相談いただけます。</span>
            </SunlitHeading>
          </div>
          <p class="max-w-2xl text-base leading-8 text-[#D8D1C5] lg:justify-self-end">
            何から始めるべきか決まっていない段階でもご相談いただけます。
            現在の課題を伺い、向き不向きも含めて優先順位を整理します。
          </p>
        </div>

        <div class="mt-12 md:mt-16" data-list>
          {consultations.map((consultation, index) => (
            <article class="group/row relative grid gap-x-10 gap-y-5 py-9 md:grid-cols-[7rem_minmax(0,1fr)] md:items-center md:py-12" data-row>
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px origin-left bg-[linear-gradient(90deg,#F4E8CB,rgba(216,194,139,0.42)_48%,rgba(216,194,139,0.08))]" data-rule />

              <div class="flex items-center gap-4">
                <span class="text-xs font-bold tracking-[0.18em] text-[#E0C584]">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span aria-hidden="true" class="h-px flex-1 origin-left bg-[linear-gradient(90deg,#E0C584,transparent)]" data-number-rule />
              </div>

              <h3 class="relative w-fit max-w-full overflow-hidden text-2xl font-bold leading-snug tracking-tight text-[#F5F1E8] transition-[color,transform] duration-500 group-hover/row:translate-x-2 group-hover/row:text-[#FFF7E3] md:text-3xl lg:text-[2.55rem]">
                <span class="relative z-10">{consultation}</span>
                {(
                  <span aria-hidden="true" class="motion-reduce:hidden absolute inset-y-[-30%] left-0 z-20 w-1/3 -translate-x-[150%] -skew-x-12 bg-[linear-gradient(90deg,transparent,rgba(255,253,247,0.26),transparent)] opacity-0 blur-sm transition-[transform,opacity] duration-1000 ease-out group-hover/row:translate-x-[430%] group-hover/row:opacity-100" />
                )}
              </h3>
            </article>
          ))}

          <span aria-hidden="true" class="block h-px origin-left bg-[linear-gradient(90deg,#F4E8CB,rgba(216,194,139,0.42)_48%,rgba(216,194,139,0.08))]" data-end-rule />
        </div>

        <div class="mt-10 flex flex-col gap-6 md:flex-row md:items-center md:justify-between" data-cta>
          <p class="max-w-xl border-l border-[rgba(224,197,132,0.5)] pl-4 text-sm leading-7 text-[#D8D1C5]">
            相談内容がまとまっていなくても大丈夫です。
          </p>
          <SpecularButton href={CONTACT_FORM_HREF} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
            相談する
          </SpecularButton>
        </div>
      </Container>
    </section>
<script>
  import { animate, inView, stagger, ease, reducedMotion, reveal } from "@shared/motion";
  const section = document.querySelector("#suitable-consultations")!;
  reveal(section.querySelector("[data-intro]")!, { opacity: [0, 1], y: [20, 0] }, { duration: 0.5 }, "-80px");
  if (!reducedMotion.matches) {
    inView(section.querySelector("[data-list]")!, () => {
      animate(section.querySelectorAll("[data-row]"), { opacity: [0, 1], y: [26, 0] }, { duration: 0.52, delay: stagger(0.1), ease });
      animate(section.querySelectorAll("[data-rule], [data-end-rule]"), { scaleX: [0, 1], opacity: [0.35, 1] }, { duration: 0.8, ease });
      animate(section.querySelectorAll("[data-number-rule]"), { scaleX: [0, 1] }, { duration: 0.65, delay: 0.18, ease });
    }, { margin: "-40px" });
  }
  reveal(section.querySelector("[data-cta]")!, { opacity: [0, 1], y: [14, 0] }, { duration: 0.45 }, "0px");
</script>
