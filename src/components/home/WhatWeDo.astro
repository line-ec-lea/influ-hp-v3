---
import Container from "@shared/Container.astro";
import SunlitHeading from "@shared/SunlitHeading.astro";
const areas = [
  {
    label: "AI戦略",
    description:
      "事業課題に合わせて、AI活用の優先順位と導入ロードマップを設計します。",
    position: "self-start -rotate-[2deg] sm:ml-2",
  },
  {
    label: "SEO",
    description:
      "検索ニーズと競合状況を整理し、必要な情報へ自然に届くサイト構造と記事設計を整えます。",
    position: "self-end rotate-[1deg] sm:mr-12",
  },
  {
    label: "マーケティング",
    description:
      "届けたい相手と価値を明確にし、発信から問い合わせまで一貫した導線を設計します。",
    position: "self-start -rotate-[1deg] sm:ml-14",
  },
  {
    label: "Webデザイン",
    description:
      "企業らしさと使いやすさを両立し、安心して相談できるWeb体験をかたちにします。",
    position: "self-end rotate-[2deg] sm:mr-4",
  },
  {
    label: "Webサイト改善",
    description:
      "ホームページを集客・信頼形成・問い合わせにつながる導線へ整えます。",
    position: "self-start -rotate-[2deg] sm:ml-8",
  },
  {
    label: "集客",
    description:
      "マーケティング視点で、見込み顧客との接点づくりと改善を支援します。",
    position: "self-end rotate-[1deg] sm:mr-14",
  },
  {
    label: "業務効率化",
    description:
      "日々の業務にAIを組み込み、現場で継続して使える仕組みにします。",
    position: "self-end rotate-[2deg] sm:mr-2",
  },
]
---
<section id="what-we-do" class="relative overflow-hidden border-t border-[rgba(200,164,93,0.25)] bg-[#0B0B0B]">
      <Container class="relative py-16 md:py-24 lg:py-28">
        <div class="mx-auto max-w-5xl" data-intro>
          <p class="text-xs font-bold tracking-[0.16em] text-[#E0C584]">
            WHAT WE DO
          </p>
          <SunlitHeading class="mt-4 max-w-5xl text-4xl font-bold leading-tight tracking-[-0.03em] md:text-5xl lg:text-6xl">
            私たちがやっていること
          </SunlitHeading>
          <p class="mt-6 max-w-3xl text-xl font-semibold leading-relaxed text-[#F5F1E8] sm:text-2xl md:text-3xl">
            難しいAIを、使い続けられる仕組みに。
          </p>
          <p class="mt-6 max-w-3xl text-base leading-8 text-[#D8D1C5]">
            企業のAI活用を、マーケティングと実装の両面から伴走します。
            ツール選定だけでなく、発信内容、Webサイト、社内運用まで整理し、現場で動き続ける仕組みとして定着させます。
          </p>
        </div>

        <div class="relative mt-12 md:mt-16" data-focus>
          <div class="relative grid min-h-[34rem] gap-12 py-8 sm:py-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(24rem,1.18fr)] lg:items-center lg:gap-16 lg:py-12">
            <div class="relative z-10">
              <p class="text-[0.65rem] font-bold tracking-[0.2em] text-[#D8C28B]">
                OUR FOCUS / 01—07
              </p>
              <p aria-hidden="true" class="mt-5 text-[clamp(3.8rem,9vw,8rem)] font-bold leading-[0.82] tracking-[-0.075em] text-[#F5F1E8]">
                AI
                <br />×<br />
                WORK
              </p>

              <div class="mt-10 max-w-xl border-l border-[rgba(216,194,139,0.52)] pl-5">
                <p class="text-xs font-bold tracking-[0.16em] text-[#D8C28B]">
                  <span data-count>01</span> / 07
                </p>
                <div  data-description>
                    <h3 class="mt-3 text-2xl font-bold tracking-tight text-[#F8F4EA] sm:text-3xl">
                      {areas[0]!.label}
                    </h3>
                    <p class="mt-3 text-sm leading-7 text-[#CFC8BC] sm:text-base sm:leading-8">
                      {areas[0]!.description}
                    </p>
                  </div>
              </div>
            </div>

            <div class="relative z-10 flex min-h-[31rem] flex-col justify-center gap-3 sm:min-h-[35rem] sm:gap-3.5">
              {areas.map((area, index) => {
                const active = index === 0

                return (
                  <button type="button" aria-pressed={active} data-label={area.label} data-description={area.description} class={`relative flex min-h-12 max-w-full cursor-pointer items-center gap-3 rounded-full border px-5 py-2.5 text-left text-lg font-bold leading-tight tracking-[-0.03em] outline-none transition-colors duration-300 focus-visible:ring-2 focus-visible:ring-[#F8F4EA] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0B0B0B] sm:min-h-14 sm:px-7 sm:text-2xl ${area.position} ${
                      active
                        ? "border-[#FFFDF7] bg-[linear-gradient(110deg,#FFFDF7_0%,#F4E8CB_48%,#DABF83_100%)] text-[#080808] shadow-[0_0_34px_rgba(244,232,203,0.24)]"
                        : "border-[rgba(226,222,214,0.42)] bg-[#090909]/80 text-[#F2EFE8] hover:border-[rgba(248,244,234,0.82)] hover:bg-[#121212] hover:text-white"
                    }`} data-area>
                    <span class={`text-[0.65rem] tracking-[0.15em] ${active ? "text-[#080808]/60" : "text-[#D8C28B]"}`}>
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span>{area.label}</span>
                  </button>
                )
              })}
            </div>
          </div>
        </div>
      </Container>
    </section>
<script>
  import { animate, ease, reducedMotion, reveal } from "@shared/motion";
  const section = document.querySelector("#what-we-do")!;
  reveal(section.querySelector("[data-intro]")!, { opacity: [0, 1], y: [22, 0] }, { duration: 0.55 });
  reveal(section.querySelector("[data-focus]")!, { opacity: [0, 1], y: [30, 0] }, { duration: 0.65 });
  const buttons = [...section.querySelectorAll<HTMLButtonElement>("[data-area]")];
  const description = section.querySelector<HTMLElement>("div[data-description]")!;
  const activeClasses = "border-[#FFFDF7] bg-[linear-gradient(110deg,#FFFDF7_0%,#F4E8CB_48%,#DABF83_100%)] text-[#080808] shadow-[0_0_34px_rgba(244,232,203,0.24)]".split(" ");
  const inactiveClasses = "border-[rgba(226,222,214,0.42)] bg-[#090909]/80 text-[#F2EFE8] hover:border-[rgba(248,244,234,0.82)] hover:bg-[#121212] hover:text-white".split(" ");
  let current = 0;
  let hovered = false;
  let focused = false;
  let revision = 0;
  async function select(index: number) {
    if (current === index) return;
    current = index;
    const update = ++revision;
    buttons.forEach((button, i) => {
      const active = i === index;
      button.setAttribute("aria-pressed", String(active));
      button.classList.remove(...(active ? inactiveClasses : activeClasses));
      button.classList.add(...(active ? activeClasses : inactiveClasses));
      button.firstElementChild!.classList.toggle("text-[#080808]/60", active);
      button.firstElementChild!.classList.toggle("text-[#D8C28B]", !active);
      if (!reducedMotion.matches) animate(button, { scale: active ? 1.035 : 1, y: active ? -2 : 0 }, { duration: 0.3, ease });
    });
    if (!reducedMotion.matches) await animate(description, { opacity: 0, y: -8 }, { duration: 0.3, ease });
    if (update !== revision) return;
    section.querySelector("[data-count]")!.textContent = String(index + 1).padStart(2, "0");
    description.querySelector("h3")!.textContent = buttons[index].dataset.label!;
    description.querySelector("p")!.textContent = buttons[index].dataset.description!;
    animate(description, { opacity: [0, 1], y: [10, 0] }, { duration: reducedMotion.matches ? 0 : 0.3, ease });
  }
  buttons.forEach((button, index) => {
    button.addEventListener("click", () => select(index));
    button.addEventListener("focus", () => { focused = true; select(index); });
    button.addEventListener("blur", () => { focused = false; });
  });
  const group = buttons[0].parentElement!;
  group.addEventListener("pointerenter", () => { hovered = true; });
  group.addEventListener("pointerleave", () => { hovered = false; });
  if (!reducedMotion.matches) animate(buttons[0], { scale: 1.035, y: -2 }, { duration: 0.3, ease });
  const timer = window.setInterval(() => {
    if (!reducedMotion.matches && !hovered && !focused && !document.hidden) select((current + 1) % buttons.length);
  }, 1150);
  window.addEventListener("pagehide", (event) => { if (!event.persisted) clearInterval(timer); });
</script>
