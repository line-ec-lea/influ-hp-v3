---
import Container from "@shared/Container.astro";
const areas = [
  {
    label: "AI戦略",
    description:
      "事業課題に合わせて、AI活用の優先順位と導入ロードマップを設計します。",
    position: "md:self-start md:ml-2",
  },
  {
    label: "SEO",
    description:
      "検索ニーズと競合状況を整理し、必要な情報へ自然に届くサイト構造と記事設計を整えます。",
    position: "md:self-end md:mr-8 lg:mr-12",
  },
  {
    label: "マーケティング",
    description:
      "届けたい相手と価値を明確にし、発信から問い合わせまで一貫した導線を設計します。",
    position: "md:self-start md:ml-6 lg:ml-14",
  },
  {
    label: "Webデザイン",
    description:
      "企業らしさと使いやすさを両立し、安心して相談できるWeb体験をかたちにします。",
    position: "md:self-end md:mr-4",
  },
  {
    label: "Webサイト改善",
    description:
      "ホームページを集客・信頼形成・問い合わせにつながる導線へ整えます。",
    position: "md:self-start md:ml-4 lg:ml-8",
  },
  {
    label: "集客",
    description:
      "マーケティング視点で、見込み顧客との接点づくりと改善を支援します。",
    position: "md:self-end md:mr-8 lg:mr-14",
  },
  {
    label: "業務効率化",
    description:
      "日々の業務にAIを組み込み、現場で継続して使える仕組みにします。",
    position: "md:self-end md:mr-2",
  },
]
const initial = 2;
---
<section id="what-we-do" class="relative overflow-hidden bg-section">
  <Container class="relative py-18 md:py-24 lg:py-28">
    <div class="max-w-5xl" data-intro>
      <p class="text-xs font-bold tracking-[0.16em] text-gold-300">WHAT WE DO</p>
      <h2 class="mt-4 text-[2rem] font-bold leading-[1.3] tracking-[-0.02em] text-foreground sm:text-4xl md:text-5xl lg:text-[3.5rem]">
        <span class="inline-block">私たちが</span><span class="inline-block">やっていること</span>
      </h2>
      <p class="mt-6 max-w-3xl text-xl font-normal leading-[1.7] text-foreground sm:text-2xl">
        <span class="inline-block">難しいAIを、</span><span class="inline-block">使い続けられる仕組みに。</span>
      </p>
      <p class="mt-4 max-w-[40rem] text-pretty text-base leading-[1.9] text-foreground/80">
        企業のAI活用を、マーケティングと実装の両面から伴走します。
        ツール選定だけでなく、発信内容、Webサイト、社内運用まで整理し、現場で動き続ける仕組みとして定着させます。
      </p>
    </div>

    <div class="relative mt-10 md:mt-14" data-focus>
      <div class="relative grid gap-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:items-center md:gap-8 lg:gap-16">
        <div class="relative z-10 min-w-0">
          <p class="text-xs font-bold tracking-[0.16em] text-gold-300" data-focus-label>OUR FOCUS / 01—07</p>
          <p aria-label="AI × WORK" data-focus-words class="mt-6 text-[clamp(5rem,17vw,6.5rem)] font-bold leading-[0.9] tracking-[-0.065em] text-foreground md:text-[clamp(5rem,9.5vw,8.5rem)]">
            <span class="block">AI</span>
            <span class="block">×</span>
            <span class="block">WORK</span>
          </p>

          <div class="mt-10 max-w-[27rem] border-l border-gold-300/50 pl-5 lg:mt-12 lg:pl-6" data-focus-detail>
            <p class="text-xs font-bold tracking-[0.16em] text-gold-300">
              <span data-count>03</span> / 07
            </p>
            <div id="capability-detail" data-detail class="min-h-48 sm:min-h-[10.5rem]" aria-live="polite" aria-atomic="true">
              <h3 class="mt-3 text-2xl font-bold leading-[1.4] tracking-[-0.01em] text-foreground lg:text-3xl">
                {areas[initial]!.label}
              </h3>
              <p class="mt-3 text-base leading-[1.9] text-foreground/80">
                {areas[initial]!.description}
              </p>
            </div>
          </div>
        </div>

        <div class="relative z-10 flex min-w-0 flex-wrap gap-3 md:flex-col md:justify-center md:gap-6 lg:gap-7" aria-label="対応領域">
          {areas.map((area, index) => (
            <div data-pill class={`max-w-full ${area.position}`}>
              <div data-pill-reveal>
                <button type="button" aria-pressed={index === initial} aria-controls="capability-detail" data-label={area.label} data-description={area.description} data-area
                  class="group relative flex min-h-12 max-w-full cursor-pointer items-center gap-3 rounded-full border border-foreground/20 bg-elevated px-4 py-3 text-left text-base font-normal leading-tight tracking-[-0.01em] text-foreground/80 transition-[color,background-color,border-color,box-shadow,scale,translate] duration-300 hover:-translate-y-0.5 hover:border-foreground/40 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-300 aria-pressed:scale-[1.025] aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-page aria-pressed:shadow-sm aria-pressed:shadow-page/20 motion-reduce:aria-pressed:scale-100 motion-reduce:hover:translate-none motion-reduce:transition-none md:min-h-14 md:px-5 md:text-xl lg:px-7 lg:text-2xl">
                  <span class="text-xs font-normal tracking-[0.12em] text-gold-300 group-aria-pressed:text-page/70">{String(index + 1).padStart(2, "0")}</span>
                  <span class="whitespace-nowrap">{area.label}</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
<script>
  import { animate, ease, reducedMotion } from "@shared/motion";
  const section = document.querySelector("#what-we-do")!;
  if (!reducedMotion.matches) {
    const targets = [...section.querySelectorAll<HTMLElement>("[data-intro] > *, [data-focus-label], [data-focus-words] > span, [data-focus-detail], [data-pill-reveal]")];
    const pending = new Set<Element>(targets);
    const entrances = new Map<Element, ReturnType<typeof animate>>();
    const distance = window.matchMedia("(min-width: 768px)").matches ? 20 : 12;
    // Only elements entering together share a stagger; a later scroll starts immediately.
    const observer = new IntersectionObserver(entries => {
      entries.filter(entry => entry.isIntersecting && pending.has(entry.target)).forEach(({ target }, index) => {
        pending.delete(target);
        observer.unobserve(target);
        entrances.set(target, animate(target, { opacity: [0, 1], y: [distance, 0] }, {
          duration: 0.6, delay: Math.min(index * 0.07, 0.21), ease,
        }));
      });
    }, { rootMargin: "0px 0px -48px 0px" });
    targets.forEach(target => {
      target.style.opacity = "0";
      observer.observe(target);
    });
    // Focus reveals just that control, without skipping the rest of the scroll sequence.
    const onFocus = (event: Event) => {
      const target = targets.find(target => target.contains(event.target as Node));
      if (!target) return;
      pending.delete(target);
      observer.unobserve(target);
      entrances.get(target)?.complete();
      animate(target, { opacity: 1, y: 0 }, { duration: 0 });
    };
    const finishEntrances = () => {
      observer.disconnect();
      pending.clear();
      entrances.forEach(animation => animation.complete());
      animate(targets, { opacity: 1, y: 0 }, { duration: 0 });
    };
    section.addEventListener("focusin", onFocus);
    reducedMotion.addEventListener("change", finishEntrances, { once: true });
    window.addEventListener("pagehide", event => {
      if (event.persisted) return;
      observer.disconnect();
      entrances.forEach(animation => animation.stop());
      section.removeEventListener("focusin", onFocus);
      reducedMotion.removeEventListener("change", finishEntrances);
    });
  }
  const buttons = [...section.querySelectorAll<HTMLButtonElement>("[data-area]")];
  const pills = [...section.querySelectorAll<HTMLElement>("[data-pill]")];
  const description = section.querySelector<HTMLElement>("[data-detail]")!;
  const desktop = window.matchMedia("(min-width: 1024px)");
  const drift = new Map<HTMLElement, ReturnType<typeof animate>>();
  let current = buttons.findIndex(button => button.getAttribute("aria-pressed") === "true");
  let revision = 0;
  let detailAnimation: ReturnType<typeof animate> | undefined;

  function syncDrift() {
    pills.forEach((pill, index) => {
      if (!desktop.matches || reducedMotion.matches || index === current) {
        if (drift.has(pill)) {
          drift.get(pill)!.stop();
          drift.delete(pill);
          animate(pill, { y: 0 }, { duration: reducedMotion.matches ? 0 : 0.3, ease });
        }
      } else if (!drift.has(pill)) {
        drift.set(pill, animate(pill, { y: [0, index % 2 ? 6 : -6, 0] }, {
          duration: 6 + (index % 3), delay: index * 0.35, repeat: Infinity, ease: "easeInOut",
        }));
      }
    });
  }

  async function select(index: number) {
    if (current === index) return;
    current = index;
    const update = ++revision;
    buttons.forEach((button, i) => button.setAttribute("aria-pressed", String(i === index)));
    syncDrift();
    detailAnimation?.stop();
    if (!reducedMotion.matches) {
      detailAnimation = animate(description, { opacity: 0, y: -4 }, { duration: 0.12, ease });
      await detailAnimation;
    }
    if (update !== revision) return;
    section.querySelector("[data-count]")!.textContent = String(index + 1).padStart(2, "0");
    description.querySelector("h3")!.textContent = buttons[index].dataset.label!;
    description.querySelector("p")!.textContent = buttons[index].dataset.description!;
    detailAnimation = animate(description, { opacity: [0, 1], y: [4, 0] }, {
      duration: reducedMotion.matches ? 0 : 0.22, ease,
    });
  }
  buttons.forEach((button, index) => {
    button.addEventListener("pointerenter", event => { if (event.pointerType === "mouse") select(index); });
    button.addEventListener("click", () => select(index));
    button.addEventListener("focus", () => select(index));
  });
  function syncMotion() {
    if (reducedMotion.matches) {
      detailAnimation?.stop();
      animate(description, { opacity: 1, y: 0 }, { duration: 0 });
      // Finish the current selection if its fade was interrupted.
      section.querySelector("[data-count]")!.textContent = String(current + 1).padStart(2, "0");
      description.querySelector("h3")!.textContent = buttons[current].dataset.label!;
      description.querySelector("p")!.textContent = buttons[current].dataset.description!;
      revision++;
    }
    syncDrift();
  }
  syncDrift();
  desktop.addEventListener("change", syncMotion);
  reducedMotion.addEventListener("change", syncMotion);
  window.addEventListener("pagehide", event => {
    if (!event.persisted) {
      drift.forEach(animation => animation.stop());
      detailAnimation?.stop();
      desktop.removeEventListener("change", syncMotion);
      reducedMotion.removeEventListener("change", syncMotion);
    }
  });
</script>
