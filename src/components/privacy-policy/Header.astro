---
import Container from "@shared/Container.astro";
import CinematicReveal from "@shared/CinematicReveal.astro";
import { breadcrumbJsonLd } from "@shared/features/seo";
const items = [{ name: "ホーム", href: "/" }, { name: "プライバシーポリシー" }];
---
<Container class="relative z-30 border-b border-line pb-10 pt-24 after:absolute after:bottom-[-1px] after:right-12 after:h-px after:w-[min(36vw,28rem)] after:bg-[linear-gradient(90deg,transparent,var(--color-line-gold))] md:pb-12 md:pt-28">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd(items)).replace(/</g, "\\u003c")} />
  <nav aria-label="パンくずリスト" class="mb-0">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-subtle sm:gap-2.5">
      <li class="inline-flex items-center gap-1.5">
        <a href="/" class="font-semibold text-muted transition-colors duration-200 hover:text-gold-300">ホーム</a>
      </li>
      <li role="presentation" aria-hidden="true" class="inline-flex items-center text-subtle">&gt;</li>
      <li class="inline-flex items-center gap-1.5">
        <span aria-current="page" class="line-clamp-1 max-w-60 font-normal text-foreground sm:max-w-md">プライバシーポリシー</span>
      </li>
    </ol>
  </nav>
  <div class="mt-10 max-w-5xl">
    <CinematicReveal>
      <p class="text-xs font-bold tracking-normal text-gold-300">Privacy</p>
      <h1 class="mt-3 max-w-4xl text-balance text-4xl font-semibold leading-[1.2] tracking-normal text-foreground md:text-6xl">プライバシーポリシー</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted md:text-lg">株式会社INFLUの個人情報保護方針をご案内します。</p>
    </CinematicReveal>
  </div>
</Container>
