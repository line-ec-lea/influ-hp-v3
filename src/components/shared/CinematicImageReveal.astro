---
interface Props { class?: string; delay?: number }
const { class: className = "", delay = 0 } = Astro.props;
---
<div class={`group relative overflow-hidden ${className}`} data-image-reveal data-delay={delay}>
  <div class="h-full w-full"><slot /></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-[linear-gradient(90deg,transparent,rgb(201_165_109_/_0.42),transparent)] mix-blend-screen opacity-0"></div>
</div>
<script>
  import { animate, inView, ease, reducedMotion } from "./motion";
  if (!reducedMotion.matches) {
    inView("[data-image-reveal]", (element) => {
      const delay = Number((element as HTMLElement).dataset.delay);
      animate(element.children[0], { clipPath: ["inset(0 100% 0 0)", "inset(0 0% 0 0)"], scale: [1.08, 1] }, { delay, duration: 1.05, ease });
      animate(element.children[1], { x: ["-120%", "420%"], opacity: [1, 1] }, { delay: delay + 0.14, duration: 1.15, ease });
    }, { amount: 0.2 });
  }
</script>
