---
interface Props { light?: boolean; class?: string; }
const { light = false, class: className = "" } = Astro.props;
---
<p data-company-section-label class:list={["inline-flex items-center gap-3.5 text-[11px] font-normal uppercase tracking-[0.3em]", light ? "text-[#060606]" : "text-[#c89a5b]", className]}>
  <span class="h-px w-7 shrink-0 bg-[#c89a5b]" aria-hidden="true"></span>
  <slot />
</p>
