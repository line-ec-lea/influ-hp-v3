---
import {
  getEmDashCollection,
  getTaxonomyTermsWithCacheHint,
  type TaxonomyTerm,
} from "emdash";
import { Image } from "emdash/ui";
import Container from "./Container.astro";
import Contact from "./Contact.astro";

type EditorialCollection =
  | "company_achievements"
  | "useful_materials"
  | "staff_blog";

interface Props {
  collection: EditorialCollection;
  basePath: string;
  sectionLabel: string;
  eyebrow: string;
  description: string;
  page: number;
  categorySlug?: string;
  categoryLabel?: string;
}

const {
  collection,
  basePath,
  sectionLabel,
  eyebrow,
  description,
  page,
  categorySlug,
  categoryLabel,
} = Astro.props;

const pageSize = 11;
const offset = (page - 1) * pageSize;
const { entries, error, cacheHint, hasMore } = await getEmDashCollection(
  collection,
  {
    status: "published",
    orderBy: { published_at: "desc" },
    limit: pageSize,
    offset,
    where: categorySlug ? { material_category: categorySlug } : undefined,
  },
);

if (error) throw error;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

let categories: TaxonomyTerm[] = [];
if (collection === "useful_materials") {
  const result = await getTaxonomyTermsWithCacheHint("material_category", {
    includeCounts: false,
  });
  categories = result.data;
  if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
}

const featuredPost = page === 1 ? entries[0] : undefined;
const archivePosts = featuredPost ? entries.slice(1) : entries;
const archiveStart = offset + (featuredPost ? 2 : 1);
const paginationBase = categorySlug
  ? `${basePath}/category/${categorySlug}/page`
  : `${basePath}/page`;
const pageTitle = categoryLabel
  ? `${categoryLabel} | ${sectionLabel}`
  : sectionLabel;
const formatDate = (date: Date | null) =>
  date?.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<div class="bg-page pt-14 text-foreground md:pt-16">
  <header class="border-b border-line-gold py-12 md:py-16">
    <Container>
      <nav aria-label="パンくず" class="text-sm text-muted">
        <a href="/" class="transition-colors hover:text-gold-300">ホーム</a>
        <span aria-hidden="true" class="mx-3 text-subtle">/</span>
        <span>{pageTitle}</span>
      </nav>
      <div class="mx-auto max-w-3xl pt-10 text-center">
        <p class="text-xs font-bold tracking-[0.18em] text-gold-300">{eyebrow}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-[-0.03em] md:text-6xl">
          {pageTitle}
        </h1>
        <p class="mt-5 text-base leading-8 text-muted md:text-lg">{description}</p>
      </div>

      {
        collection === "useful_materials" && (
          <nav aria-label="コラムのカテゴリー" class="mt-9 flex flex-wrap justify-center gap-2">
            <a
              href={`${basePath}/page/1`}
              aria-current={!categorySlug ? "page" : undefined}
              class:list={[
                "inline-flex min-h-10 items-center border px-4 py-2 text-sm font-semibold transition-colors",
                !categorySlug
                  ? "border-gold-300 bg-accent text-page"
                  : "border-line-gold text-gold-300 hover:border-gold-300 hover:text-foreground",
              ]}
            >
              すべて
            </a>
            {categories.map((category) => (
              <a
                href={`${basePath}/category/${category.slug}/page/1`}
                aria-current={category.slug === categorySlug ? "page" : undefined}
                class:list={[
                  "inline-flex min-h-10 items-center border px-4 py-2 text-sm font-semibold transition-colors",
                  category.slug === categorySlug
                    ? "border-gold-300 bg-accent text-page"
                    : "border-line-gold text-gold-300 hover:border-gold-300 hover:text-foreground",
                ]}
              >
                {category.label}
              </a>
            ))}
          </nav>
        )
      }
    </Container>
  </header>

  <Container class="py-12 md:py-16">
    {
      entries.length === 0 ? (
        <div class="border-y border-line-gold py-20 text-center">
          <p class="text-lg font-semibold text-foreground">記事はまだありません。</p>
          <p class="mt-3 text-sm text-muted">公開された記事がここに表示されます。</p>
        </div>
      ) : (
        <>
          {featuredPost && (
            <section aria-label={`最新の${sectionLabel}`}>
              <a
                href={`${basePath}/${featuredPost.id}`}
                class="group grid overflow-hidden border-y border-line-gold bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 lg:grid-cols-[minmax(0,1.45fr)_minmax(19rem,0.75fr)]"
              >
                <div class="aspect-[16/10] overflow-hidden bg-elevated lg:aspect-[16/9] [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-700 group-hover:[&_img]:scale-[1.03]">
                  {featuredPost.data.featured_image ? (
                    <Image image={featuredPost.data.featured_image} priority />
                  ) : (
                    <span class="flex h-full items-center justify-center text-xs font-bold tracking-[0.18em] text-subtle">
                      NO IMAGE
                    </span>
                  )}
                </div>
                <div class="flex min-h-64 flex-col justify-end px-6 py-8 lg:border-l lg:border-line-gold lg:px-10 lg:py-12">
                  <span class="text-xs font-bold tracking-[0.18em] text-gold-300">
                    01 / FEATURED STORY
                  </span>
                  <h2 class="mt-7 text-2xl font-semibold leading-relaxed tracking-normal transition-colors group-hover:text-gold-300 sm:text-3xl">
                    {featuredPost.data.title}
                  </h2>
                  {featuredPost.data.excerpt && (
                    <p class="mt-4 line-clamp-3 leading-7 text-muted">{featuredPost.data.excerpt}</p>
                  )}
                  {featuredPost.data.publishedAt && (
                    <time class="mt-5 text-sm text-subtle" datetime={featuredPost.data.publishedAt.toISOString()}>
                      {formatDate(featuredPost.data.publishedAt)}
                    </time>
                  )}
                  <span class="mt-8 text-xs font-bold tracking-[0.16em] text-gold-300">
                    READ STORY →
                  </span>
                </div>
              </a>
            </section>
          )}

          {archivePosts.length > 0 && (
            <section aria-labelledby="archive-heading" class={featuredPost ? "mt-12 md:mt-16" : ""}>
              <h2 id="archive-heading" class="sr-only">{sectionLabel}一覧</h2>
              <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
                {archivePosts.map((post, index) => (
                  <article class="min-w-0 border-b border-line-gold pb-7">
                    <a
                      href={`${basePath}/${post.id}`}
                      class="group flex h-full flex-col focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300"
                    >
                      <div class="aspect-[16/10] overflow-hidden bg-elevated [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-700 group-hover:[&_img]:scale-[1.03]">
                        {post.data.featured_image ? (
                          <Image image={post.data.featured_image} />
                        ) : (
                          <span class="flex h-full items-center justify-center text-xs font-bold tracking-[0.18em] text-subtle">
                            NO IMAGE
                          </span>
                        )}
                      </div>
                      <div class="flex flex-1 flex-col pt-5">
                        <div class="flex items-center justify-between gap-4 text-xs">
                          <span class="font-bold tracking-[0.18em] text-gold-300">
                            {String(archiveStart + index).padStart(2, "0")} / ARCHIVE
                          </span>
                          {post.data.publishedAt && (
                            <time class="text-subtle" datetime={post.data.publishedAt.toISOString()}>
                              {formatDate(post.data.publishedAt)}
                            </time>
                          )}
                        </div>
                        <h3 class="mt-5 text-xl font-semibold leading-relaxed transition-colors group-hover:text-gold-300">
                          {post.data.title}
                        </h3>
                        {post.data.excerpt && (
                          <p class="mt-3 line-clamp-2 text-sm leading-7 text-muted">{post.data.excerpt}</p>
                        )}
                        <span class="mt-auto self-end pt-7 text-gold-300" aria-hidden="true">→</span>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </section>
          )}

          <nav aria-label="ページネーション" class="mt-14 flex items-center justify-center gap-3">
            {page > 1 && (
              <a
                href={`${paginationBase}/${page - 1}`}
                class="inline-flex min-h-11 items-center border border-line-gold px-4 text-sm font-semibold text-gold-300 transition-colors hover:border-gold-300 hover:text-foreground"
              >
                ← 前へ
              </a>
            )}
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center border border-gold-300 bg-accent px-3 text-sm font-bold text-page">
              {page}
            </span>
            {hasMore && (
              <a
                href={`${paginationBase}/${page + 1}`}
                class="inline-flex min-h-11 items-center border border-line-gold px-4 text-sm font-semibold text-gold-300 transition-colors hover:border-gold-300 hover:text-foreground"
              >
                次へ →
              </a>
            )}
          </nav>
        </>
      )
    }
  </Container>
</div>

<Contact />
