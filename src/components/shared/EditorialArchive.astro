---
import {
  getTaxonomyTermsWithCacheHint,
  type TaxonomyTerm,
} from "emdash";
import { Image } from "emdash/ui";
import Container from "./Container.astro";
import Contact from "./Contact.astro";
import type { loadEditorialArchive } from "./editorial-archive";

type EditorialCollection =
  | "company_achievements"
  | "useful_materials"
  | "staff_blog";

interface Props {
  collection: EditorialCollection;
  basePath: string;
  sectionLabel: string;
  eyebrow: string;
  description: string;
  page: number;
  availableEntries: Awaited<ReturnType<typeof loadEditorialArchive>>["entries"];
  categorySlug?: string;
  categoryLabel?: string;
}

const {
  collection,
  basePath,
  sectionLabel,
  eyebrow,
  description,
  page,
  availableEntries,
  categorySlug,
  categoryLabel,
} = Astro.props;

// The first page has a featured story plus four complete rows of cards.
const pageSize = page === 1 ? 13 : 12;
let categories: TaxonomyTerm[] = [];
if (collection === "useful_materials") {
  const result = await getTaxonomyTermsWithCacheHint("material_category", {
    includeCounts: false,
  });
  categories = result.data;
  if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
}

const entries = availableEntries.slice(0, pageSize);
const hasMore = availableEntries.length > pageSize;
const lastVisiblePage = page + Math.ceil(Math.max(0, availableEntries.length - pageSize) / 12);
const paginationEnd = Math.min(Math.max(5, page + 2), lastVisiblePage);
const paginationStart = Math.max(1, paginationEnd - 4);
const pageNumbers = Array.from({ length: paginationEnd - paginationStart + 1 }, (_, index) => paginationStart + index);

const featuredPost = page === 1 ? entries[0] : undefined;
const archivePosts = featuredPost ? entries.slice(1) : entries;
const paginationBase = categorySlug
  ? `${basePath}/category/${categorySlug}/page`
  : `${basePath}/page`;
const pageTitle = categoryLabel
  ? `${categoryLabel} | ${sectionLabel}`
  : sectionLabel;
const formatDate = (date: Date | null) =>
  date?.toLocaleDateString("ja-JP", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<div class="bg-page pt-14 text-foreground md:pt-16">
  <header class="border-b border-line-gold py-12 md:py-16">
    <Container class="!px-4 sm:!px-6">
      <nav aria-label="パンくず" class="text-sm text-muted">
        <a href="/" class="transition-colors hover:text-gold-300">ホーム</a>
        <span aria-hidden="true" class="mx-3 text-subtle">/</span>
        <span>{pageTitle}</span>
      </nav>
      <div class="mx-auto max-w-3xl pt-10 text-center">
        <p class="text-xs font-bold tracking-[0.18em] text-gold-300">{eyebrow}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-[-0.03em] md:text-6xl">
          {pageTitle}
        </h1>
        <p class="mt-5 text-base leading-8 text-muted md:text-lg">{description}</p>
      </div>

      {
        collection === "useful_materials" && (
          <nav aria-label="コラムのカテゴリー" class="mt-9 flex flex-wrap gap-2">
            <a
              href={`${basePath}/page/1`}
              aria-current={!categorySlug ? "page" : undefined}
              class:list={[
                "inline-flex min-h-10 items-center rounded-lg border px-4 py-2 text-sm font-semibold transition-colors",
                !categorySlug
                  ? "border-gold-300 bg-accent text-page"
                  : "border-gold-400 text-gold-300 hover:bg-gold-400/10 hover:text-foreground",
              ]}
            >
              すべて
            </a>
            {categories.map((category) => (
              <a
                href={`${basePath}/category/${category.slug}/page/1`}
                aria-current={category.slug === categorySlug ? "page" : undefined}
                class:list={[
                  "inline-flex min-h-10 items-center rounded-lg border px-4 py-2 text-sm font-semibold transition-colors",
                  category.slug === categorySlug
                    ? "border-gold-300 bg-accent text-page"
                    : "border-gold-400 text-gold-300 hover:bg-gold-400/10 hover:text-foreground",
                ]}
              >
                {category.label}
              </a>
            ))}
          </nav>
        )
      }
    </Container>
  </header>

  <Container class="!px-4 py-12 sm:!px-6 md:py-16">
    {
      entries.length === 0 ? (
        <div class="border-y border-line-gold py-20 text-center">
          <p class="text-lg font-semibold text-foreground">記事はまだありません。</p>
          <p class="mt-3 text-sm text-muted">公開された記事がここに表示されます。</p>
        </div>
      ) : (
        <>
          {featuredPost && (
            <section aria-label={`最新の${sectionLabel}`}>
              <a
                href={`${basePath}/${featuredPost.id}`}
                class="group grid items-center gap-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300 lg:grid-cols-2 lg:gap-10"
              >
                <div class="aspect-[3/2] overflow-hidden rounded-md bg-elevated [&_picture]:h-full [&_img]:!h-full [&_img]:!w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-700 group-hover:[&_img]:scale-[1.03]">
                  {featuredPost.data.featured_image ? (
                    <Image image={featuredPost.data.featured_image} width={1200} height={800} sizes="(min-width: 1024px) 600px, calc(100vw - 32px)" priority />
                  ) : (
                    <span class="flex h-full items-center justify-center text-xs font-bold tracking-[0.18em] text-subtle">
                      NO IMAGE
                    </span>
                  )}
                </div>
                <div class="flex flex-col justify-center py-2">
                  <span class="text-xs font-bold tracking-[0.18em] text-gold-300">
                    最新の{sectionLabel}
                  </span>
                  <h2 class="mt-4 text-2xl font-semibold leading-relaxed tracking-normal transition-colors group-hover:text-gold-300 sm:text-3xl">
                    {featuredPost.data.title}
                  </h2>
                  {featuredPost.data.excerpt && (
                    <p class="mt-4 line-clamp-3 leading-7 text-muted">{featuredPost.data.excerpt}</p>
                  )}
                  {featuredPost.data.publishedAt && (
                    <time class="mt-5 text-sm text-subtle" datetime={featuredPost.data.publishedAt.toISOString()}>
                      {formatDate(featuredPost.data.publishedAt)}
                    </time>
                  )}
                </div>
              </a>
            </section>
          )}

          {archivePosts.length > 0 && (
            <section aria-labelledby="archive-heading" class={featuredPost ? "mt-12 md:mt-16" : ""}>
              <h2 id="archive-heading" class="mb-8 text-xl font-semibold">{sectionLabel}一覧</h2>
              <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
                {archivePosts.map((post) => (
                  <article class="min-w-0">
                    <a
                      href={`${basePath}/${post.id}`}
                      class="group flex h-full flex-col focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300"
                    >
                      <div class="aspect-[3/2] overflow-hidden rounded-md bg-elevated [&_picture]:h-full [&_img]:!h-full [&_img]:!w-full [&_img]:object-cover [&_img]:transition-transform [&_img]:duration-700 group-hover:[&_img]:scale-[1.03]">
                        {post.data.featured_image ? (
                          <Image image={post.data.featured_image} width={600} height={400} sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, calc(100vw - 32px)" />
                        ) : (
                          <span class="flex h-full items-center justify-center text-xs font-bold tracking-[0.18em] text-subtle">
                            NO IMAGE
                          </span>
                        )}
                      </div>
                      <div class="flex flex-1 flex-col pt-5">
                        <h3 class="text-lg font-semibold leading-relaxed transition-colors group-hover:text-gold-300">
                          {post.data.title}
                        </h3>
                        {post.data.excerpt && (
                          <p class="mt-3 line-clamp-3 text-sm leading-7 text-muted">{post.data.excerpt}</p>
                        )}
                        {post.data.publishedAt && (
                          <time class="mt-4 text-sm text-subtle" datetime={post.data.publishedAt.toISOString()}>
                            {formatDate(post.data.publishedAt)}
                          </time>
                        )}
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </section>
          )}

          <nav aria-label="ページネーション" class="mt-14 flex flex-wrap items-center justify-center gap-1 sm:gap-2">
            {page > 1 && (
              <a
                href={`${paginationBase}/${page - 1}`}
                aria-label="前のページ"
                class="inline-flex min-h-11 min-w-9 items-center justify-center rounded-lg border border-gold-400 px-2 text-sm font-semibold text-gold-300 sm:px-4 transition-colors hover:border-gold-300 hover:text-foreground"
              >
                <span aria-hidden="true" class="sm:hidden">←</span>
                <span class="hidden sm:inline">← 前へ</span>
              </a>
            )}
            {pageNumbers.map((number) => (
              <a
                href={`${paginationBase}/${number}`}
                aria-label={`${number}ページ目`}
                aria-current={number === page ? "page" : undefined}
                class:list={[
                  "inline-flex min-h-11 min-w-9 items-center justify-center rounded-lg border px-2 sm:min-w-11 sm:px-3 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-300",
                  number === page ? "border-gold-300 bg-accent text-page" : "border-gold-400 text-gold-300 hover:bg-gold-400/10",
                ]}
              >{number}</a>
            ))}
            {hasMore && (
              <a
                href={`${paginationBase}/${page + 1}`}
                aria-label="次のページ"
                class="inline-flex min-h-11 min-w-9 items-center justify-center rounded-lg border border-gold-400 px-2 text-sm font-semibold text-gold-300 sm:px-4 transition-colors hover:border-gold-300 hover:text-foreground"
              >
                <span aria-hidden="true" class="sm:hidden">→</span>
                <span class="hidden sm:inline">次へ →</span>
              </a>
            )}
          </nav>
        </>
      )
    }
  </Container>
</div>

<Contact />
