---
import Container from "./Container.astro";
import { siteNavItems } from "@shared/features/navigation";
import { routes } from "@shared/features/routes";
import { SITE_NAME, SITE_URL } from "@shared/features/seo";
const isHome = Astro.url.pathname === "/";
const showDividers = !isHome;
const isLife = Astro.url.pathname === "/staff-wellbeing" || Astro.url.pathname === "/staff-wellbeing/";
const lifeFocus = "focus-visible:rounded-[2px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-life-gold";
---
{isLife ? (
  <footer data-site-footer data-home={false} data-life-footer class="relative z-2 mt-auto bg-page pt-[150px] font-sans text-[15px] font-normal leading-[1.9] tracking-[0.02em] text-life-ink [--life-gutter:40px] [&_a:focus-visible]:outline-offset-4! [&_a:focus-visible]:outline-life-gold! [@media(max-width:1100px)]:[--life-gutter:28px] [@media(max-width:720px)]:pt-[100px] [@media(max-width:720px)]:[--life-gutter:18px]">
    <div class="relative mx-auto flex max-w-life justify-between gap-5 border-t border-life-line px-[var(--life-gutter)] pt-[26px] pb-[30px] [@media(max-width:720px)]:flex-col">
      <nav aria-label="サイトマップ" class="flex flex-wrap gap-x-7 gap-y-2.5 border-t border-life-line pt-10 pb-[30px] text-[13px] text-life-muted">
        {siteNavItems.map(item => <a href={new URL(item.href, SITE_URL).href} class={`hover:text-life-ink ${lifeFocus}`}>{item.label}</a>)}
      </nav>
      <div class="flex flex-wrap justify-between gap-x-8 gap-y-5 border-t border-life-line pt-[22px] pb-[30px] text-[11px] leading-[1.6] tracking-[0.18em] text-life-muted uppercase [@media(max-width:720px)]:flex-col [@media(max-width:720px)]:gap-2.5">
        <span class="mr-auto">Copyright© 株式会社INFLU, 2019-2026 All Rights Reserved</span>
        <a class={`inline-flex items-center gap-2.5 transition-colors ease-[ease] duration-[350ms] hover:text-life-gold ${lifeFocus}`} href={new URL(routes.privacyPolicy, SITE_URL).href}>プライバシーポリシー</a>
        <a class={`inline-flex items-center gap-2.5 transition-colors ease-[ease] duration-[350ms] hover:text-life-gold ${lifeFocus}`} href="#top">Back to top ↑</a>
      </div>
    </div>
  </footer>
) : (
<footer data-site-footer data-home={isHome} class="bg-[#0B0B0B] text-[#F5F1E8]" class:list={[showDividers && Astro.url.pathname !== "/business-content" && "border-t border-[rgba(200,164,93,0.25)]"]}>
      <Container class={isHome ? "py-16 md:py-20" : "py-12 md:py-16"}>
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
          <div data-footer-group>
            <a href={routes.home} class="inline-flex rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-[#E0C584] focus-visible:ring-offset-4 focus-visible:ring-offset-[#0B0B0B]">
              <img src="/influ-logo.svg" alt={SITE_NAME} width={120} height={64} class="h-8 w-auto drop-shadow-[0_0_10px_rgba(245,241,232,0.2)]" />
            </a>
            <p class={isHome ? "mt-6 max-w-sm text-base leading-[1.9] text-foreground/80" : "mt-5 max-w-sm text-sm leading-7 text-[#B8B1A3]"}>
              株式会社INFLUは、企業のAI活用・AXをマーケティング実務とセットで伴走する会社です。
            </p>
          </div>

          <nav data-footer-group aria-label="フッターナビゲーション">
            <h2 class="font-bold text-[#F5F1E8]" class:list={[isHome ? "text-base leading-[1.5]" : "text-sm"]}>サイトマップ</h2>
            <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1" class:list={[isHome ? "text-base leading-[1.9]" : "text-sm"]}>
              {siteNavItems.map((item) => (
                <li>
                  <a href={item.href} class="inline-flex min-h-11 items-center text-[#B8B1A3] transition-colors duration-200 hover:text-[#E0C584] focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E0C584]">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div data-footer-group>
            <h2 class="font-bold text-[#F5F1E8]" class:list={[isHome ? "text-base leading-[1.5]" : "text-sm"]}>会社情報</h2>
            <address class="mt-4 space-y-3 not-italic text-[#B8B1A3]" class:list={[isHome ? "text-base leading-[1.9]" : "text-sm leading-7"]}>
              <p>{SITE_NAME}</p>
              <a href={`${routes.company}#a02`} class="block transition-colors duration-200 hover:text-[#E0C584] focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E0C584]">
                〒550-0013
                <br />
                大阪府大阪市西区新町1丁目8-3
                <br />
                林四ツ橋ビル9階901号室
              </a>
              <p>
                電話番号:{" "}
                <a href="tel:06-7222-2971" class="inline-flex min-h-11 items-center transition-colors duration-200 hover:text-[#E0C584] focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E0C584]">
                  06-7222-2971
                </a>
              </p>
            </address>
          </div>
        </div>

        <div data-footer-group class="mt-10 flex flex-col gap-4 pt-6 text-xs text-[#B8B1A3] sm:flex-row sm:items-center sm:justify-between" class:list={[showDividers && "border-t border-[rgba(200,164,93,0.25)]"]}>
          <p>
            Copyright&copy; {SITE_NAME}, 2019-{new Date().getFullYear()} All
            Rights Reserved
          </p>
          <a href={routes.privacyPolicy} class="inline-flex min-h-11 items-center transition-colors duration-200 hover:text-[#E0C584] focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E0C584]">
            プライバシーポリシー
          </a>
        </div>
      </Container>
    </footer>
)}
