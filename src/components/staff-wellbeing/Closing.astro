---
const link = "group flex items-center justify-between gap-2.5 border-t border-life-line-strong py-5 text-[17px] font-bold tracking-[0.01em] transition-colors ease-[ease] duration-[350ms] hover:text-life-gold focus-visible:rounded-[2px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-life-gold last:border-b";
const arrow = "inline-block transition-transform duration-[450ms] ease-life group-hover:translate-x-[5px] motion-reduce:transition-none";
---

<section aria-labelledby="cl-t" class="relative z-1 flex min-h-0 flex-col pt-[220px] pb-[140px] [@media(max-width:720px)]:pt-[130px]" data-life-closing>
  <div class="relative mx-auto grid w-full max-w-life grid-cols-12 gap-x-[var(--life-gutter)] px-[var(--life-gutter)]">
    <h2 id="cl-t" class="col-start-1 col-end-12 m-0 text-[clamp(56px,8vw,132px)] font-bold leading-[0.9] tracking-[-0.045em] [@media(max-width:1100px)]:col-span-12 [@media(max-width:720px)]:text-[14vw]"><span class="block -mb-[0.08em] overflow-hidden pb-[0.08em]" data-life-line><span class="block">Work with us.</span></span></h2>
    <p class="col-start-1 col-end-8 m-0 mt-11 text-[clamp(18px,1.6vw,22px)] font-bold leading-[1.55] tracking-[0.06em]">この毎日を、一緒につくりませんか。</p>
    <nav aria-label="関連情報" class="col-start-9 col-end-13 self-end [@media(max-width:1100px)]:col-span-12 [@media(max-width:1100px)]:mt-14" data-life-closing-links>
      <a class={link} href="https://influhp.com/staff-blog/page/1"><span>スタッフブログを読む</span><span class={arrow}>→</span></a>
      <a class={link} href="https://melodious-sight-6bd.notion.site/2099e621302e466fa97bf45f31eed426" target="_blank" rel="noopener"><span>採用情報を見る</span><span class={arrow}>↗</span></a>
    </nav>
  </div>
</section>
