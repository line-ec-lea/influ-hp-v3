---
const meta = "text-[11px] font-normal leading-[1.6] tracking-[0.18em] text-life-muted uppercase";
const focus = "focus-visible:rounded-[2px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-life-gold";
---

<section id="contact" aria-labelledby="ct-t" class="relative z-2 border-t border-life-line bg-page pt-[200px] pb-40 [@media(max-width:720px)]:pt-[120px] [@media(max-width:720px)]:pb-[90px]" data-life-contact>
  <div class="relative mx-auto grid max-w-life grid-cols-12 gap-x-[var(--life-gutter)] px-[var(--life-gutter)]">
    <div class="col-start-1 col-end-6 [@media(max-width:720px)]:col-span-12" data-life-contact-head>
      <p class={`${meta} my-[1em]`}>Contact</p>
      <h2 id="ct-t" class="m-0 mt-[18px] text-[clamp(34px,4vw,64px)] font-bold leading-[1.55] tracking-[0.06em]">お問い合わせ</h2>
    </div>
    <div class="col-start-7 col-end-13 self-end [@media(max-width:720px)]:col-span-12 [@media(max-width:720px)]:mt-12" data-life-contact-body>
      <a class={`group flex items-center justify-between gap-2.5 border-y border-life-line-strong py-[22px] text-[clamp(22px,2vw,30px)] font-bold transition-colors ease-[ease] duration-[350ms] hover:text-life-gold ${focus}`} href="https://melodious-sight-6bd.notion.site/37b947bdbcf480dc97d1ce7f01cff921" target="_blank" rel="noopener"><span>相談する</span><span class="inline-block transition-transform duration-[450ms] ease-life group-hover:translate-x-[5px] motion-reduce:transition-none">↗</span></a>
      <dl class="m-0 mt-10 grid grid-cols-[1fr_1.6fr] gap-7 [@media(max-width:720px)]:grid-cols-1" data-life-contact-info>
        <div><dt class={`${meta} mb-2`}>Tel</dt><dd class="m-0 text-[15px] leading-[1.8]"><a class={focus} href="tel:06-7222-2971">06-7222-2971</a></dd></div>
        <div><dt class={`${meta} mb-2`}>Office</dt><dd class="m-0 text-[15px] leading-[1.8]">〒550-0013<br />大阪府大阪市西区新町1丁目8-3<br />林四ツ橋ビル9階901号室</dd></div>
      </dl>
    </div>
  </div>
</section>
