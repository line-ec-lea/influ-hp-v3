---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

// Reuse the reference's EmDash renditions; frames reserve space and own the crops.
const images = {
  "summer-veg": { id: "01M3TG537J88Y0YTXJTY4CW4PW", src: "https://influhp.com/_image?href=https%3A%2F%2Finfluhp.com%2F_emdash%2Fapi%2Fmedia%2Ffile%2F01M3TG537J88Y0YTXJTY4CW4PW.jpeg&w=1180&h=1572&f=webp&q=92", alt: "やました農園さんから届いた夏野菜の箱" },
  "egg": { id: "01M3TGJQEMYY6XCCBK94W8TSNB", src: "https://influhp.com/_image?href=https%3A%2F%2Finfluhp.com%2F_emdash%2Fapi%2Fmedia%2Ffile%2F01M3TGJQEMYY6XCCBK94W8TSNB.png&w=736&h=970&f=webp&q=92", alt: "中野さんが作ったゆで卵" },
} satisfies Record<string, MediaValue>;

const grid = "grid grid-cols-12 gap-x-[var(--life-gutter)]";
const meta = "text-[11px] font-normal leading-[1.6] tracking-[0.18em] text-life-muted uppercase";
const photo = "relative overflow-hidden bg-elevated";
const focus = "focus-visible:rounded-[2px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-life-gold";
---

<section id="stories" aria-labelledby="st-t" class="relative z-1 overflow-x-clip pt-[120px] pb-20 [--life-gutter:40px] [@media(max-width:1100px)]:[--life-gutter:28px] [@media(max-width:720px)]:py-20 [@media(max-width:720px)]:[--life-gutter:18px]" data-life-stories>
  <div class="relative mx-auto max-w-life px-[var(--life-gutter)]">
    <span class="pointer-events-none absolute -top-[0.5em] -left-[0.05em] z-0 text-[clamp(200px,21vw,320px)] font-thin leading-[0.78] tracking-[-0.06em] text-life-gold/30 select-none [@media(max-width:720px)]:relative [@media(max-width:720px)]:top-auto [@media(max-width:720px)]:left-auto [@media(max-width:720px)]:-mb-[0.32em] [@media(max-width:720px)]:block [@media(max-width:720px)]:text-[42vw]" aria-hidden="true" data-life-numeral>03</span>
    <div class="relative z-2 grid gap-3 pl-[19%] [@media(max-width:1100px)]:pl-0" data-life-stories-heading>
      <p class="m-0 text-xs font-bold leading-[1.6] tracking-[0.12em] text-life-gold">03 — 日々の暮らし</p>
      <h2 id="st-t" class="m-0 text-[clamp(76px,9.4vw,150px)] font-bold leading-[0.9] tracking-[-0.03em] uppercase [@media(max-width:720px)]:text-[15.5vw]">Daily life</h2>
      <p class="m-0 text-[clamp(17px,1.5vw,21px)] font-bold leading-[1.55] tracking-[0.06em]">健やかさが、暮らしに続く。</p>
    </div>

    <article class={`${grid} mt-16 items-start [@media(max-width:720px)]:mt-16`} data-life-feature>
      <figure class="col-start-1 col-end-7 m-0 -ml-[var(--life-gutter)] [@media(max-width:1100px)]:col-end-8 [@media(max-width:720px)]:col-span-12 [@media(max-width:720px)]:-mr-[var(--life-gutter)]" data-life-vegetables>
        <div class={`${photo} aspect-[4/3]`} data-life-reveal><Image image={images["summer-veg"]} class="h-full! w-full! object-cover object-[50%_45%]" /></div>
        <figcaption class={`${meta} mt-3 pl-[var(--life-gutter)] [@media(max-width:720px)]:pr-[var(--life-gutter)]`}>やました農園さんの夏野菜 — 2026.07.24</figcaption>
      </figure>
      <div class="col-start-8 col-end-13 pt-10 [@media(max-width:1100px)]:col-span-12 [@media(max-width:1100px)]:pt-12" data-life-feature-text>
        <span class={meta}><b class="font-bold text-life-ink">暮らしの変化</b> — 野菜とエンジニア</span>
        <h3 class="mt-[22px] mb-10 text-[clamp(30px,3.1vw,48px)] font-bold leading-[1.45] tracking-[0.06em]">届いた野菜で、<br />自炊を始めた<br />エンジニア。</h3>
        <p class="m-0 text-[15px] leading-[2] tracking-[0.04em] text-life-ink/90">毎月、会社に届く野菜。その野菜をきっかけに、自宅で料理を始めたメンバーもいます。スタッフブログには、ドライカレーやゆで卵づくりなど、自炊の様子がつづられています。</p>
        <blockquote class="mx-0 my-6 border-l border-life-gold/50 pl-5">
          <p class="m-0 text-xl font-bold leading-[1.7] tracking-[0.04em]">「外食するより、自分で作った方がいいやん！」</p>
          <a class={`mt-3 inline-block text-sm text-life-muted hover:text-life-gold ${focus}`} href="https://influhp.com/staff-blog/staffreport-6575">メンバーの自炊の話を読む →</a>
        </blockquote>
        <figure class="m-0 mt-12 ml-auto w-[56%] [@media(max-width:720px)]:w-[66%]" data-life-egg>
          <div class={`${photo} aspect-[4/5]`}><Image image={images.egg} class="h-full! w-full! object-cover object-[50%_80%]" /></div>
          <figcaption class={`${meta} mt-2.5`}>シルバーウィーク前のゆで卵講座🍳</figcaption>
        </figure>
      </div>
    </article>

    <div class="mt-16 flex items-baseline justify-between border-t border-life-line-strong pt-[30px] [@media(max-width:720px)]:mt-12 [@media(max-width:720px)]:flex-col [@media(max-width:720px)]:gap-3" data-life-archive>
      <span class={meta}>日々の出来事を、スタッフブログで</span>
      <a class={`group inline-flex items-center gap-2.5 text-[clamp(30px,3.4vw,52px)] font-bold tracking-[-0.035em] transition-colors ease-[ease] duration-[350ms] hover:text-life-gold ${focus}`} href="https://influhp.com/staff-blog/page/1">記事一覧を見る <span class="inline-block transition-transform duration-[450ms] ease-life group-hover:translate-x-[5px] motion-reduce:transition-none">→</span></a>
    </div>
  </div>
</section>
