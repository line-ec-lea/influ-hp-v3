---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

// Reuse the reference's existing EmDash renditions, without a second local transform.
// The photo frames below reserve layout space and own the editorial crops.
const images = {
  balanceBall: {
    id: "01M3TGHTW73K9X8AJ7DWQQXB3F",
    src: "https://influhp.com/_image?href=https%3A%2F%2Finfluhp.com%2F_emdash%2Fapi%2Fmedia%2Ffile%2F01M3TGHTW73K9X8AJ7DWQQXB3F.png&w=1012&h=718&f=webp&q=92",
    alt: "バランスボールに座って笑うスタッフ",
  },
  room: {
    id: "01M3TGHSB4BYT18JMXWBR1MS5J",
    src: "https://influhp.com/_image?href=https%3A%2F%2Finfluhp.com%2F_emdash%2Fapi%2Fmedia%2Ffile%2F01M3TGHSB4BYT18JMXWBR1MS5J.png&w=855&h=623&f=webp&q=92",
    alt: "研修が行われるミーティングルーム",
  },
} satisfies Record<string, MediaValue>;

const grid = "grid grid-cols-12 gap-x-[var(--life-gutter)]";
const meta = "text-[11px] font-normal leading-[1.6] tracking-[0.18em] text-life-muted uppercase";
const photo = "relative overflow-hidden bg-elevated";
const fact = "grid grid-cols-[1fr_auto] items-end border-b border-life-line-strong pt-[22px] pb-5";
const factValue = "text-right text-[clamp(44px,4.2vw,68px)] font-bold leading-[0.9] tracking-[-0.04em]";
const factUnit = "ml-[6px] text-xs font-normal leading-[0.9] tracking-[0.18em] text-life-muted";

// Exact source enhancement; the base grid remains usable without JS or with reduced motion.
const horizontalStyles = [
  "motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:h-[200vh] motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:mt-10 motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:mx-[calc(50%_-_50vw)]",
  "motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:sticky motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:top-0 motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:h-screen motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:flex motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:items-center motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:overflow-hidden",
  "motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:flex motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:gap-[3vw] motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:px-[var(--life-gutter)] motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:[transform:translate3d(var(--hx,0px),0,0)] motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:will-change-transform",
  "motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-lead]]:order-none motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-lead]]:flex-none motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-lead]]:w-[min(24vw,360px)] motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-lead]]:self-center",
  "motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-item]]:flex-none motion-safe:[@media(min-width:901px)]:data-[life-horizontal]:[&_[data-life-hseq-item]]:w-[min(72vh,72vw)]",
];


---

<section id="move" aria-labelledby="move-t" class="relative z-1 scroll-mt-24 overflow-x-clip pt-10 [--life-gutter:40px] [@media(max-width:1100px)]:[--life-gutter:28px] [@media(max-width:720px)]:[--life-gutter:18px]" data-life-move>
  <div class="relative mx-auto max-w-life px-[var(--life-gutter)]">
    <div class="relative z-2 grid gap-3 pl-8 [@media(max-width:720px)]:pl-3" data-life-move-heading>
      <p class="m-0 text-xs font-bold leading-[1.6] tracking-[0.12em] text-life-gold">01 — 身体の健康</p>
      <h2 id="move-t" class="m-0 text-[clamp(76px,9.4vw,150px)] font-bold leading-[0.9] tracking-[-0.03em] uppercase [@media(max-width:720px)]:text-[15.5vw]">Vitality</h2>
      <p class="m-0 text-[clamp(17px,1.5vw,21px)] font-bold leading-[1.55] tracking-[0.06em]">からだが弾む。</p>
      <p class="m-0 mt-3 max-w-[42em] text-[15px] leading-[2] tracking-[0.04em] text-life-ink/90">毎週水曜日は、キックボクシングの日。バランスボールを使った運動や、仲間とジムに行く時間もあります。身体を動かすことを、日々の中に取り入れています。</p>
    </div>

    <div class:list={["relative mt-16", horizontalStyles]} data-life-hseq>
      <div data-life-hseq-pin>
        <div class="grid grid-cols-[repeat(12,1fr)] items-start gap-6 [@media(max-width:720px)]:gap-4" data-life-hseq-track>
          <p class="order-9 col-span-12 m-0 text-[clamp(18px,1.6vw,22px)] font-bold leading-[1.55] tracking-[0.06em]" data-life-hseq-lead>週に一度、身体を動かすきっかけを。<br /><span class="mt-2 inline-block text-sm font-normal leading-[1.8] tracking-[0.04em] text-life-ink/90">毎週水曜日のキックボクシング。参加無料で、どなたでも参加できます。</span></p>
          <figure class="col-span-6 m-0 [@media(max-width:720px)]:col-span-12" data-life-hseq-item>
            <div class={`${photo} aspect-[4/3]`} data-life-reveal>
              <img src="/media/staff-wellbeing/boxing-wide.jpg" alt="オフィスでミットを打つメンバーたち" width="1920" height="818" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          </figure>
          <figure class="col-span-6 m-0 [@media(max-width:720px)]:col-span-12" data-life-hseq-item>
            <div class={`${photo} aspect-[4/3]`}>
              <img src="/media/staff-wellbeing/boxing-laugh.jpg" alt="ミット打ちで笑うメンバー" width="940" height="818" loading="lazy" decoding="async" class="h-full w-full object-cover object-[50%_30%]" />
            </div>
          </figure>
          <figure class="col-span-6 m-0 [@media(max-width:720px)]:col-span-12" data-life-hseq-item>
            <div class={`${photo} aspect-[4/3]`}>
              <img src="/media/staff-wellbeing/film-laugh.jpg" alt="笑い合うメンバー" width="1600" height="682" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          </figure>
          <figure class="col-span-6 m-0 [@media(max-width:720px)]:col-span-12" data-life-hseq-item>
            <div class={`${photo} aspect-[4/3]`}>
              <img src="/media/staff-wellbeing/film-floor.jpg" alt="マットに座りこんで笑うメンバー" width="1600" height="682" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
            <figcaption class={`mt-3 ${meta}`}>キックボクシング会の動画より</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <div class={`${grid} mt-16 items-start [@media(max-width:720px)]:mt-10`} data-life-move-body>
      <figure class="relative z-1 col-start-1 col-end-9 m-0 -ml-[var(--life-gutter)] [@media(max-width:1100px)]:col-span-12 [@media(max-width:1100px)]:-mr-[var(--life-gutter)]" data-life-move-lead>
        <div class={`${photo} aspect-[3/2] [@media(max-width:720px)]:aspect-[4/5]`} data-life-reveal>
          <Image image={images.balanceBall} class="h-full! w-full! object-cover object-[42%_62%]" data-life-image-drift />
        </div>
        <figcaption class={`${meta} pt-[14px] pl-[var(--life-gutter)] [@media(max-width:720px)]:px-[var(--life-gutter)] [@media(max-width:720px)]:pt-3`}>バランスボールを使って、身体を動かす時間。</figcaption>
      </figure>
      <div class="col-start-10 col-end-13 grid gap-14 [@media(max-width:1100px)]:col-span-12 [@media(max-width:1100px)]:mt-14 [@media(max-width:1100px)]:grid-cols-2 [@media(max-width:1100px)]:gap-10 [@media(max-width:720px)]:grid-cols-1" data-life-move-side>
        <div>
          <h3 class="m-0 text-xl font-bold leading-[1.6] tracking-[0.04em]">バランスボールで、身体を動かす。</h3>
          <p class="mt-3 mb-6 text-sm leading-[2] text-life-ink/90">社員向けに、バランスボールを使った運動も取り入れています。キックボクシングのほかにも、身体を動かす機会があります。</p>
          <div class="grid gap-0 border-t border-life-line-strong">
          <div class={fact}><span class={meta}><b class="font-bold text-life-ink">キックボクシング</b></span><span class={factValue}>01<small class={factUnit}>回／週</small></span></div>
          <div class={fact}><span class={meta}><b class="font-bold text-life-ink">バランスボール</b></span><span class={factValue}><small class="text-[22px] font-bold tracking-[0.02em]">社員向け</small></span></div>
          </div>
        </div>
        <figure class="m-0">
          <div class={`${photo} aspect-[4/5]`}>
            <img src="/media/staff-wellbeing/boxing-gloves.jpg" alt="ブルーのグローブを構えるメンバー" width="654" height="818" loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </div>
          <figcaption class={`${meta} mt-3 flex flex-wrap justify-between gap-1`}><span>毎週のキックボクシング会</span><span>動画より</span></figcaption>
        </figure>
      </div>
    </div>

    <div id="mind" class={`${grid} relative z-2 mt-24 scroll-mt-24 items-start gap-y-10 [@media(max-width:720px)]:mt-16`} data-life-mind>
      <div class="col-start-1 col-end-7 [@media(max-width:1100px)]:col-span-12">
        <p class={meta}><b class="font-bold text-life-ink">心の健やかさへ</b></p>
        <h3 class="my-[18px] text-[clamp(26px,2.6vw,40px)] font-bold leading-[1.45] tracking-[0.06em]">身体の健康も、<br />心の健やかさも。</h3>
        <p class="m-0 max-w-[32em] text-[15px] leading-[2] tracking-[0.04em] text-life-ink/90">身体を動かす。仲間と笑い合う。キックボクシングの映像から、メンバーが一緒に過ごす時間をご紹介します。</p>
      </div>
      <figure class="col-start-8 col-end-12 m-0 [@media(max-width:1100px)]:col-span-8 [@media(max-width:720px)]:col-span-12" data-life-monthly-photo>
        <div class={`${photo} aspect-[16/10]`}>
          <Image image={images.room} class="h-full! w-full! object-cover object-[30%_70%]" />
        </div>
        <figcaption class={`${meta} mt-2.5`}>身体づくりの研修の様子。</figcaption>
      </figure>
      <div class="col-span-12 mt-4 grid grid-cols-2 gap-[var(--life-gutter)] [@media(max-width:720px)]:grid-cols-1" data-life-mind-photos>
        <div class="flex aspect-[4/3] items-center justify-center bg-elevated" data-life-photo-placeholder>
          <p class="m-0 text-xs tracking-[0.08em] text-life-muted">写真を追加予定</p>
        </div>
        <div class="flex aspect-[4/3] items-center justify-center bg-elevated" data-life-photo-placeholder>
          <p class="m-0 text-xs tracking-[0.08em] text-life-muted">写真を追加予定</p>
        </div>
        <div class="flex aspect-[4/3] items-center justify-center bg-elevated" data-life-photo-placeholder>
          <p class="m-0 text-xs tracking-[0.08em] text-life-muted">写真を追加予定</p>
        </div>
        <div class="flex aspect-[4/3] items-center justify-center bg-elevated" data-life-photo-placeholder>
          <p class="m-0 text-xs tracking-[0.08em] text-life-muted">写真を追加予定</p>
        </div>
      </div>
    </div>
  </div>
</section>
