---
// The two stories stack by default; desktop scrolling enhances them horizontally.
const horizontal = [
  "motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:h-[190vh] motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:min-h-[1300px]",
  "motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:sticky motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:top-0 motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:h-svh motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:min-h-[680px] motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-pin]]:overflow-hidden",
  "motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:flex motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:h-full motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:[transform:translate3d(var(--hx,0px),0,0)] motion-safe:[@media(min-width:761px)_and_(min-height:800px)]:data-[life-horizontal]:[&_[data-life-hseq-track]]:will-change-transform",
];
const panel = "flex min-h-svh w-full shrink-0 items-center px-[var(--life-gutter)] py-20 [@media(max-width:760px)]:py-[110px]";
const body = "mt-8 max-w-[37em] text-base leading-[2] tracking-[0.04em] [&_p]:m-0 [&_p+p]:mt-3.5 [@media(max-width:760px)]:text-[15px] [@media(max-width:760px)]:leading-[2.15]";
---

<section id="move" aria-labelledby="wellbeing-title" class:list={["relative z-1", horizontal]} data-life-move>
  <div class="relative" data-life-hseq-pin>
    <div data-life-hseq-track>
      <div class={panel}>
        <div class="w-full max-w-[850px]">
          <p class="m-0 mb-8 text-[11px] tracking-[0.16em] text-life-gold [@media(max-width:760px)]:text-[10px]">INFLUのウェルビーイング</p>
          <p class="m-0 mb-8 text-xs font-bold tracking-[0.14em] text-life-gold"><span class="mr-5 font-normal text-life-ink/55">01</span>身体の健康</p>
          <h2 id="wellbeing-title" class="m-0 text-[clamp(34px,4.5vw,76px)] font-bold leading-[1.48] tracking-[0.025em] [@media(max-width:760px)]:text-[clamp(31px,7vw,48px)]"><span class="block">身体を動かす時間を、</span><span class="block">日々の中に。</span></h2>
          <div class={body}>
            <p>水曜日は、仲間とキックボクシング。ミットを打って、身体を動かして、一緒に汗を流します。いつも一緒に働いているメンバーと運動するのも、INFLUではおなじみの光景です。</p>
            <p>ほかにも、バランスボールのレッスンに参加したり、仲間とジムへ出かけたりしています。仕事をするだけでは見えない一面に触れられるのも、一緒に身体を動かす楽しみのひとつです。</p>
          </div>

        </div>
      </div>
      <div class:list={[panel, "justify-end [@media(max-width:760px)]:min-h-[90svh]"]} data-life-move-body>
        <div class="w-full max-w-[720px]">
          <p class="m-0 mb-8 text-xs font-bold tracking-[0.14em] text-life-gold">身体を動かす、もうひとつの時間</p>
          <h3 class="m-0 text-[clamp(34px,4vw,62px)] font-bold leading-[1.48] tracking-[0.025em] [@media(max-width:760px)]:text-[clamp(31px,7vw,48px)]"><span class="block">バランスボールでも、</span><span class="block">身体を動かす。</span></h3>
          <div class={body}>
            <p>オンラインで講師とつながり、みんなでバランスボールのレッスンを受けています。肩まわりを伸ばすストレッチから、腹筋や二の腕を使うポーズまで、いろいろな動きに挑戦します。</p>
            <p>ある日のレッスンは45分間。参加したスタッフからは、なかなかハードだったという感想もありました。その日の身体の状態に合わせて、跳ねる動きを少なくするなど、内容を調整しながら取り組んでいます。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
