---
const wrap = "mx-auto w-full max-w-life px-10 [@media(max-width:1100px)]:px-7 [@media(max-width:720px)]:px-[18px]";
const line = "block overflow-hidden pb-[0.08em] -mb-[0.08em]";
---

<section class="relative z-1 flex min-h-svh items-start pt-[132px] [@media(max-width:720px)]:pt-[104px]" aria-labelledby="life-opening-title" data-life-opening>
  <div class={`relative ${wrap}`}>
    <div class="mb-7 flex justify-between text-[11px] leading-[1.6] tracking-[0.18em] text-life-muted uppercase [@media(max-width:720px)]:flex-col [@media(max-width:720px)]:gap-[6px]" data-life-metadata>
      <span><b class="font-bold text-life-ink">Culture &amp; Benefits</b></span>
      <span>株式会社INFLU — 福利厚生・社内文化</span>
    </div>
    <h1 id="life-opening-title" class="m-0 text-[clamp(72px,11.6vw,196px)] font-bold leading-[0.9] tracking-[-0.045em] [@media(max-width:720px)]:text-[16.5vw]">
      <span class={line} data-life-line><span class="block">Life at</span></span>
      <span class={`${line} pl-[0.9em] [@media(max-width:720px)]:pl-0`} data-life-line><span class="block">INFLU.</span></span>
    </h1>
  </div>

  <div class={`absolute inset-x-0 bottom-[72px] flex items-end justify-between gap-6 [@media(max-width:720px)]:bottom-10 [@media(max-width:720px)]:flex-col [@media(max-width:720px)]:items-start [@media(max-width:720px)]:gap-[14px] ${wrap}`} data-life-opening-foot>
    <p class="m-0 text-[clamp(24px,2.6vw,40px)] font-bold leading-[1.55] tracking-[0.04em] [@media(max-width:720px)]:text-[5.6vw]" data-life-statement>
      <span class={line} data-life-line><span class="block">仕事の合間に、身体を動かす。</span></span>
      <span class={line} data-life-line><span class="block">ここは、INFLUのオフィス。</span></span>
    </p>
    <span class="text-[11px] leading-[1.6] tracking-[0.18em] whitespace-nowrap uppercase" data-life-film-caption><b class="font-bold">Film</b> — INFLUキックボクシング会</span>
  </div>

  <span class="absolute bottom-6 left-1/2 -translate-x-1/2 text-[11px] leading-[1.6] tracking-[0.18em] uppercase after:mx-auto after:mt-2 after:block after:h-7 after:w-px after:bg-[linear-gradient(var(--color-life-ink),transparent)] after:content-[''] [@media(max-width:720px)]:hidden" aria-hidden="true" data-life-scroll-cue>Scroll</span>
</section>
