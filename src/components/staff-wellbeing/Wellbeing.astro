---
import { Image } from "emdash/ui";

const pillars = [
  {
    title: "身体の健康",
    image: {
      id: "boxing-wide",
      src: "/media/staff-wellbeing/boxing-wide.jpg",
      alt: "ミットを使ってキックボクシングを楽しむINFLUのスタッフ",
      focalX: 0.15,
      focalY: 0.5,
    },
    heading: "身体を動かす習慣を、職場から。",
    description: "毎週水曜日のキックボクシングや、バランスボールを使った運動。みんなで身体を動かす機会をつくっています。キックボクシングは参加無料で、社員なら誰でも参加できます。",
  },
  {
    title: "心の健やかさ",
    image: {
      id: "film-laugh",
      src: "/media/staff-wellbeing/film-laugh.jpg",
      alt: "身体を動かしながら笑い合うINFLUのスタッフ",
    },
    heading: "気分を切り替える時間も、大切に。",
    description: "仕事の合間に身体を動かしたり、仲間と気軽に話したり。日々の中に、ひと息つける時間をつくることを大切にしています。",
  },
  {
    title: "人とのつながり",
    image: {
      id: "01M3TG1B5WXFSVEPPW3WZYVC1Y",
      src: "https://influhp.com/_image?href=https%3A%2F%2Finfluhp.com%2F_emdash%2Fapi%2Fmedia%2Ffile%2F01M3TG1B5WXFSVEPPW3WZYVC1Y.png&w=1410&h=1040&f=webp&q=92",
      alt: "ランチのテーブルを囲むINFLUのメンバー",
    },
    heading: "一緒に食べて、話して、知り合う。",
    description: "野菜を囲むランチや食事会、これまでに開いたワークショップ。共に過ごす時間を通じて、仕事の話だけでは生まれない交流を育んでいます。",
  },
];
---

<section id="wellbeing" aria-labelledby="wellbeing-title" class="relative z-1 py-[120px] [@media(max-width:720px)]:py-20" data-life-wellbeing>
  <div class="mx-auto max-w-life px-[var(--life-gutter)]">
    <p class="m-0 pt-6 text-xs font-bold tracking-[0.12em] text-life-gold">INFLUのウェルビーイング</p>
    <div class="mt-10 grid grid-cols-12 items-end gap-x-[var(--life-gutter)] gap-y-8 [@media(max-width:900px)]:mt-8">
      <h2 id="wellbeing-title" class="col-span-7 m-0 text-[clamp(30px,3.8vw,56px)] font-bold leading-[1.5] tracking-[0.04em] [@media(max-width:900px)]:col-span-12">
        <span class="block -mb-[0.08em] overflow-hidden pb-[0.08em]" data-life-line><span class="block">からだが弾む。</span></span>
        <span class="block -mb-[0.08em] overflow-hidden pb-[0.08em]" data-life-line><span class="block">心がほどける。</span></span>
        <span class="block -mb-[0.08em] overflow-hidden pb-[0.08em]" data-life-line><span class="block">笑顔がつながる。</span></span>
      </h2>
      <p class="col-span-5 m-0 max-w-[32em] text-[15px] leading-[2] tracking-[0.04em] text-life-ink/90 [@media(max-width:900px)]:col-span-12">身体が健やかで、心にゆとりがあり、人とのつながりを感じられること。その状態を日々の暮らしの中で育んでいくのが、INFLUの考えるウェルビーイングです。</p>
    </div>
    <div class="mt-14 grid grid-cols-3 gap-x-[var(--life-gutter)] gap-y-8 [@media(max-width:900px)]:grid-cols-1">
      {pillars.map(pillar => (
        <div class="pt-6" data-life-pillar>
          <h3 class="m-0 text-lg font-bold tracking-[0.06em] text-life-gold">{pillar.title}</h3>
          <div class="mt-5 aspect-[4/3] overflow-hidden bg-elevated" data-life-reveal>
            <div class="h-full w-full" data-life-reveal-scale>
              <Image image={pillar.image} class="h-full! w-full! object-cover" />
            </div>
          </div>
          <p class="m-0 mt-5 text-[17px] font-bold leading-[1.8] tracking-[0.03em]">{pillar.heading}</p>
          <p class="m-0 mt-3 text-sm leading-[2] tracking-[0.04em] text-life-ink/90">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
