---
import { Font } from "astro:assets";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import ThemeSwitcher from "../components/company/ThemeSwitcher.astro";
import {
  CONTACT_URL,
  navigation,
  organization,
  SITE_NAME,
  SITE_URL,
} from "../data/site";
import "../styles/company.css";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const robots =
  noindex || Astro.url.hostname !== new URL(SITE_URL).hostname
    ? "noindex, nofollow"
    : "index, follow";
const pageCtx = createPublicPageContext({
  Astro,
  kind: "custom",
  pageType: "website",
  title: fullTitle,
  description,
  canonical,
  siteName: SITE_NAME,
  image: new URL("/opengraph-image.png", SITE_URL).href,
  seo: { robots },
});
---

<!doctype html>
<html
  lang="ja"
  class="scheme-light-dark [&.light]:scheme-light [&.dark]:scheme-dark scroll-pt-28"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <EmDashHead page={pageCtx} />
    <meta property="og:locale" content="ja_JP" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization).replace(/</g, "\\u003c")}
    />
    <script is:inline>
      (() => {
        const theme = document.cookie
          .split("; ")
          .find((row) => row.startsWith("theme="))
          ?.slice(6);
        if (theme === "light" || theme === "dark")
          document.documentElement.classList.add(theme);
      })();
    </script>
    {Astro.url.hostname === new URL(SITE_URL).hostname && <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-574C7JR");
    </script>}
  </head>
  <body class="m-0 bg-canvas text-ink antialiased [font-family:var(--font-body),sans-serif] [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-accent [&_:focus-visible]:outline-offset-4 selection:bg-ink selection:text-canvas motion-reduce:[&_*]:transition-none">
    <EmDashBodyStart page={pageCtx} />
    <a
      class="fixed -top-24 left-5 z-50 bg-ink px-6 py-4 text-canvas focus:top-3"
      href="#main-content"
    >
      本文へスキップ
    </a>
    <header class="sticky top-0 z-30 flex h-19 items-center justify-between gap-3 border-b border-rule bg-canvas px-5 sm:h-23 sm:gap-6 sm:px-8 xl:px-12 2xl:px-16">
      <a
        class="flex shrink-0 items-center gap-3"
        href="/"
        aria-label="株式会社INFLU ホーム"
      >
        <span
          class="h-8 w-12 bg-ink mask-[url(/influ-logo.svg)] mask-contain mask-center mask-no-repeat sm:h-10 sm:w-15"
          aria-hidden="true"
        ></span>
        <span class="hidden text-[9px] leading-relaxed tracking-wider sm:block">
          AI & MARKETING
          <br />
          PARTNER
        </span>
      </a>
      <nav
        class="hidden items-center gap-6 text-xs font-medium min-[1100px]:flex [&_a]:py-3 [&_a:hover]:text-accent [&_a[aria-current=page]]:text-accent"
        aria-label="メインナビゲーション"
      >
        {navigation.slice(1).map((item) => (
          <a
            href={item.href}
            aria-current={Astro.url.pathname === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="flex items-center gap-5 sm:gap-6">
        <ThemeSwitcher />
        <a
          class="hidden min-h-11 items-center gap-6 text-xs hover:text-accent min-[1100px]:flex"
          href={CONTACT_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          相談する <span aria-hidden="true">↗</span>
        </a>
        <details class="mobile-menu group min-[1100px]:hidden">
          <summary
            class="flex min-h-11 cursor-pointer list-none items-center gap-4 [&::-webkit-details-marker]:hidden"
            aria-label="ナビゲーションメニュー"
          >
            <span class="hidden text-[10px] sm:block">MENU</span>
            <span
              class="h-2 w-6 border-y group-open:h-px"
              aria-hidden="true"
            ></span>
          </summary>
          <nav
            class="absolute top-full right-0 left-0 max-h-[calc(100dvh-76px)] overflow-y-auto border-b border-rule bg-canvas px-5 pt-4 pb-8 shadow-xl sm:px-8 [&_a]:flex [&_a]:items-center [&_a]:gap-6 [&_a]:border-b [&_a]:border-rule [&_a]:py-5 [&_a]:text-lg [&_a:hover]:text-accent [&_a>span:last-child]:ml-auto"
            aria-label="モバイルナビゲーション"
          >
            {navigation.map((item, index) => (
              <a
                href={item.href}
                aria-current={
                  Astro.url.pathname === item.href ? "page" : undefined
                }
              >
                <span class="font-mono text-xs tracking-wide text-secondary">
                  0{index + 1}
                </span>
                {item.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
            <a href={CONTACT_URL} target="_blank" rel="noopener noreferrer">
              <span class="font-mono text-xs tracking-wide text-secondary">
                06
              </span>
              相談する<span aria-hidden="true">↗</span>
            </a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="px-5 pt-18 sm:px-8 xl:px-12 2xl:px-16">
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 pb-12 md:grid-cols-[2fr_1fr_1fr] md:gap-10 md:pb-20">
        <div class="col-span-2 md:col-span-1">
          <a
            href="/"
            class="text-[clamp(4rem,8vw,9rem)] leading-none font-bold tracking-[-.07em] hover:text-accent [&_span]:ml-3 [&_span]:align-top [&_span]:text-[.5em] [&_span]:font-normal"
          >
            INFLU<span>↗</span>
          </a>
          <p class="mt-6 text-xs">技術とマーケティングを、現場の力に。</p>
        </div>
        <div class="text-xs leading-loose [&_address]:mb-3 [&_address]:text-secondary [&_address]:not-italic">
          <p class="mb-4">{SITE_NAME}</p>
          <address>
            〒550-0013
            <br />
            大阪府大阪市西区新町1丁目8-3
            <br />
            林四ツ橋ビル9階901号室
          </address>
          <a href="tel:06-7222-2971">06-7222-2971</a>
        </div>
        <nav
          class="flex flex-col gap-1 text-xs [&_a]:flex [&_a]:justify-between [&_a]:py-3 [&_a:hover]:text-accent"
          aria-label="フッターナビゲーション"
        >
          {navigation.slice(1).map((item) => (
            <a href={item.href}>
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </div>
      <div class="flex flex-wrap justify-between gap-4 border-t border-rule py-6 text-[10px] tracking-wide">
        <span>© {new Date().getFullYear()} INFLU INC.</span>
        <span class="hidden sm:inline">OSAKA, JAPAN</span>
        <a href="/privacy-policy">プライバシーポリシー</a>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu?.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (
          menu?.open &&
          event.target instanceof Node &&
          !menu.contains(event.target)
        )
          menu.open = false;
      });
      window
        .matchMedia("(min-width: 1100px)")
        .addEventListener("change", (event) => {
          if (event.matches && menu) menu.open = false;
        });
    </script>
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
