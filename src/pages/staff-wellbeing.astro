---
import Company from "../layouts/Company.astro";
import VideoStage from "../components/staff-wellbeing/VideoStage.astro";
import Opening from "../components/staff-wellbeing/Opening.astro";
import Mind from "../components/staff-wellbeing/Mind.astro";
import Move from "../components/staff-wellbeing/Move.astro";
import EatTogether from "../components/staff-wellbeing/EatTogether.astro";

// Progressive enhancement: the server-rendered page stays visible without JavaScript.
// Hero line reveals stay intact; later chapters use gentle vertical entry.
const revealStyles = [
  "motion-safe:[&_[data-life-line][data-life-pending]>span]:translate-y-[106%]",
  "motion-safe:data-[life-reveals]:[&_[data-life-line]>span]:transition-transform motion-safe:data-[life-reveals]:[&_[data-life-line]>span]:duration-[1300ms] motion-safe:data-[life-reveals]:[&_[data-life-line]>span]:ease-life",
  "motion-safe:data-[life-reveals]:[&_[data-life-line]+[data-life-line]>span]:delay-100 motion-safe:data-[life-reveals]:[&_[data-life-line]+[data-life-line]+[data-life-line]>span]:delay-200",
  "motion-safe:[&_[data-life-fade][data-life-pending]]:opacity-0 motion-safe:[&_[data-life-fade][data-life-pending]]:translate-y-[34px]",
  "motion-safe:data-[life-reveals]:[&_[data-life-fade]]:transition-[opacity,transform] motion-safe:data-[life-reveals]:[&_[data-life-fade]]:duration-[850ms,1100ms] motion-safe:data-[life-reveals]:[&_[data-life-fade]]:ease-life",
  "[&_[data-life-instant]]:transition-none! [&_[data-life-instant]_*]:transition-none!",
];

---

<Company
  title="More than work"
  description="株式会社INFLUの福利厚生と社内文化。身体の健康、学びと気づき、人とのつながりを大切に、キックボクシングやバランスボール、忍体心操術の研修、ランチ会などの日常をご紹介します。"
  noindex
>
  <div id="top" class="bg-page font-sans text-[15px] font-normal leading-[1.9] tracking-[0.02em] text-life-ink [--life-gutter:40px] [&_a:focus-visible]:outline-offset-4! [&_a:focus-visible]:outline-life-gold! [@media(max-width:1100px)]:[--life-gutter:28px] [@media(max-width:720px)]:[--life-gutter:18px]" data-life-page>
    <div id="story" class:list={["relative", revealStyles]} data-life-story>
      <VideoStage />
      <Opening />
      <div id="wellbeing" class="[--life-gutter:clamp(22px,5vw,88px)]" data-life-chapters>
        <Move />
        <Mind />
        <EatTogether />
      </div>
      <div class="relative z-1 h-[44vh] [@media(max-width:720px)]:h-[36vh]" aria-hidden="true" data-life-story-end></div>
    </div>
  </div>
</Company>
