---
import { decodeSlug, getEmDashEntry } from "emdash";
import Company from "../../layouts/Company.astro";
import CinematicPageFrame from "@shared/CinematicPageFrame.astro";
import EditorialArticle from "@shared/EditorialArticle.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry, error, cacheHint } = await getEmDashEntry("useful_materials", slug);
if (error) {
  console.error("Unable to load useful_materials article", error);
  return new Response("Unable to load article", { status: 500 });
}
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Company title={entry.data.title} description={entry.data.excerpt ?? "株式会社INFLUのコラム記事です。"}>
  <CinematicPageFrame editorial>
    <EditorialArticle
      entry={entry}
      collection="useful_materials"
      basePath="/useful-materials"
      sectionLabel="コラム"
      eyebrow="Column"
    />
  </CinematicPageFrame>
</Company>
