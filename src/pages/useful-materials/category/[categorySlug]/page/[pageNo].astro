---
import { decodeSlug, getTerm } from "emdash";
import Company from "../../../../../layouts/Company.astro";
import CinematicPageFrame from "@shared/CinematicPageFrame.astro";
import EditorialArchive from "@shared/EditorialArchive.astro";
import { loadEditorialArchive } from "@shared/editorial-archive";

const page = Number(Astro.params.pageNo);
const categorySlug = decodeSlug(Astro.params.categorySlug);
if (!Number.isInteger(page) || page < 1 || !categorySlug) return Astro.rewrite("/404");

const category = await getTerm("material_category", categorySlug, {
  includeCounts: false,
});
if (!category) return Astro.rewrite("/404");

const { entries, error, cacheHint } = await loadEditorialArchive("useful_materials", page, category.slug);
if (error) {
  console.error("Unable to load useful_materials archive", error);
  return new Response("Unable to load archive", { status: 500 });
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (page > 1 && entries.length === 0) return Astro.rewrite("/404");

const title = `${category.label} | コラム${page > 1 ? `（${page}ページ目）` : ""}`;
const description = "マーケティングや事業運営に役立つ記事を掲載しています。";
---

<Company title={title} description={description}>
  <CinematicPageFrame editorial>
    <EditorialArchive
      collection="useful_materials"
      basePath="/useful-materials"
      sectionLabel="コラム"
      eyebrow="Column"
      description={description}
      page={page}
      availableEntries={entries}
      categorySlug={category.slug}
      categoryLabel={category.label}
    />
  </CinematicPageFrame>
</Company>
