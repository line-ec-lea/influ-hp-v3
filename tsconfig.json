{
	"extends": "astro/tsconfigs/base",
	"compilerOptions": {
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@company/*": ["./src/components/company/*"],
			"@shared/*": ["./src/components/shared/*"]
		}
	},
	"include": ["src", ".astro/types.d.ts", "emdash-env.d.ts", "worker-configuration.d.ts"]
}
